#!/usr/bin/env bash
# Installs host-specific configuration that dotbot can't manage:
#   - hardware-specific packages from config/host/packages-host-repo.txt
#       (NVIDIA driver/CUDA, Intel microcode, etc. — varies per machine)
#   - /etc/systemd/system/drive-sync.{service,timer}            (system, root)
#   - host-specific ~/.config/systemd/user/*.service/*.timer/*.target
#   - user unit enablement groups: default.target, work.target, timers.target
#
# Idempotent: safe to re-run after editing the unit files in this repo.

set -euo pipefail

BASEDIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
SYS_SRC="$BASEDIR/config/host/systemd/system"
USER_SRC="$BASEDIR/config/host/systemd/user"
USER_DST="${XDG_CONFIG_HOME:-$HOME/.config}/systemd/user"

say() { printf '\n=== %s ===\n' "$*"; }

enable_user_units() {
  local units=("$@")
  local existing=()
  local unit

  for unit in "${units[@]}"; do
    if systemctl --user cat "$unit" >/dev/null 2>&1; then
      existing+=("$unit")
    else
      printf 'Skipping %s; unit file is not installed.\n' "$unit"
    fi
  done

  if ((${#existing[@]})); then
    systemctl --user enable --now "${existing[@]}"
  fi
}

# ------------------------------------------------------------------
# Hardware-specific packages (NVIDIA + Intel ucode on this host)
# ------------------------------------------------------------------
HOST_REPO_LIST="$BASEDIR/config/host/packages-host-repo.txt"
if [[ -s "$HOST_REPO_LIST" ]]; then
  say "Installing host-specific repo packages"
  grep -v '^#\|^$' "$HOST_REPO_LIST" | sudo pacman -S --needed --noconfirm -
fi

# ------------------------------------------------------------------
# System units (drive-sync) — needs sudo
# ------------------------------------------------------------------
say "Installing system units (drive-sync) — sudo required"

sudo install -m 644 "$SYS_SRC/drive-sync.service" /etc/systemd/system/drive-sync.service
sudo install -m 644 "$SYS_SRC/drive-sync.timer"   /etc/systemd/system/drive-sync.timer

sudo systemctl daemon-reload
sudo systemctl enable --now drive-sync.timer

# ------------------------------------------------------------------
# User units — copied into ~/.config/systemd/user
# ------------------------------------------------------------------
say "Installing host user units"
mkdir -p "$USER_DST"

while IFS= read -r -d '' unit_file; do
  install -m 644 "$unit_file" "$USER_DST/$(basename "$unit_file")"
done < <(find "$USER_SRC" -maxdepth 1 -type f \( -name '*.service' -o -name '*.timer' -o -name '*.target' \) -print0 | sort -z)

# hermes-gateway-driver-shield-slack.service used to be installed directly
# under default.target. It now belongs to work.target only.
rm -f "$USER_DST/default.target.wants/hermes-gateway-driver-shield-slack.service"

systemctl --user daemon-reload

# ------------------------------------------------------------------
# User unit enablement
# ------------------------------------------------------------------
say "Enabling default user services"
enable_user_units \
  hermes-gateway.service \
  kittylitter.service \
  mahore-viewer.service \
  mmo-mouse-workspaces.service \
  rclone-pcloud.service

say "Enabling automatic work target"
enable_user_units \
  work.target \
  driver-shield-main-demo.service \
  hermes-gateway-driver-shield-slack.service

say "Enabling user timers"
enable_user_units \
  credit-claim.timer \
  imoto-wiki-publish.timer

say "Installing user units (hermes-restic-backup)"
if [[ -r "$HOME/.config/restic/hermes-password" ]]; then
  systemctl --user enable --now hermes-restic-backup.timer
else
  printf 'Skipping enable for hermes-restic-backup.timer; create ~/.config/restic/hermes-password and initialize the restic repo first.\n'
fi

# ------------------------------------------------------------------
# Verify
# ------------------------------------------------------------------
say "Verifying timer status"
systemctl list-timers --all --no-pager | grep -E 'drive-sync|credit-claim|imoto-wiki' || true
systemctl --user list-timers --all --no-pager | grep -E 'credit-claim|imoto-wiki|hermes-restic' || true
systemctl --user list-dependencies work.target --plain --no-pager || true

say "Done."
