#!/usr/bin/env bash
# i3blocks block for meeting-scribe.
#
# Renders an emoji based on the recording state. When crashed recordings
# (ffmpeg died without `stop` being pressed) are queued, the idle glyph
# changes to ⚠ and the right-click menu offers Record / Process crashed.
#
# Right-click while idle (no crashed)     -> template picker -> start
# Right-click while idle (crashed queued) -> Record | Process crashed (N) -> submenu
# Right-click while recording             -> stop / cancel
# Right-click while processing            -> notify (busy)
#
# State changes signal i3blocks (SIGRTMIN+14) so the bar redraws immediately
# instead of waiting for the next interval.

set -uo pipefail

STATE_DIR="${XDG_STATE_HOME:-$HOME/.local/state}/meeting-scribe"
STATE_FILE="$STATE_DIR/state"
LOG_FILE="$STATE_DIR/block.log"
SESSION_FILE="$STATE_DIR/current.json"
SCRIBE="$HOME/.local/bin/meeting-scribe"
BLOCK_SIGNAL=14

mkdir -p "$STATE_DIR"

current_state() {
    if [ -f "$STATE_FILE" ]; then cat "$STATE_FILE"; else echo "idle"; fi
}

set_state() {
    echo "$1" > "$STATE_FILE"
    pkill -RTMIN+${BLOCK_SIGNAL} i3blocks 2>/dev/null || true
}

# If we crash-rebooted while a recording was active, the state file would
# still say "recording" but the session file is gone. Drop back to idle so
# the bar doesn't get stuck.
reconcile_state() {
    if [ "$(current_state)" = "recording" ] && [ ! -f "$SESSION_FILE" ]; then
        echo idle > "$STATE_FILE"
    fi
}

menu_pick() {
    local prompt="$1"
    if command -v rofi >/dev/null; then
        rofi -dmenu -p "$prompt" -i
    elif command -v dmenu >/dev/null; then
        dmenu -p "$prompt"
    else
        notify-send -u critical "meeting-scribe" "Need rofi or dmenu installed"
        return 1
    fi
}

# Returns the JSON list from `meeting-scribe crashed --json`, or "[]" on error.
# Memoised within a single block invocation so the click handler and the
# glyph render don't both spawn a Python interpreter.
_CRASHED_JSON_CACHE=""
crashed_json() {
    if [ -z "$_CRASHED_JSON_CACHE" ]; then
        _CRASHED_JSON_CACHE=$("$SCRIBE" crashed --json 2>>"$LOG_FILE" || echo "[]")
    fi
    printf '%s' "$_CRASHED_JSON_CACHE"
}

crashed_count() {
    crashed_json | jq 'length'
}

start_recording() {
    local choice
    choice=$(printf 'default\n1on1' | menu_pick "Template")
    [ -z "${choice:-}" ] && return 0
    if "$SCRIBE" start --template "$choice" >>"$LOG_FILE" 2>&1; then
        set_state recording
    else
        notify-send -u critical "meeting-scribe" "Start failed (see $LOG_FILE)"
    fi
}

# Build human-readable rows for the crashed submenu.
# Format: "<session-id> — <slug> (Xm)"; the id is the first whitespace token.
process_crashed_menu() {
    local rows choice id
    rows=$(crashed_json | jq -r \
        '.[] | "\(.id) — \(.slug) (\(.duration_seconds / 60 | floor)m)"')
    if [ -z "$rows" ]; then
        notify-send "meeting-scribe" "No crashed recordings"
        return 0
    fi
    choice=$(printf '%s\nProcess all' "$rows" | menu_pick "Process crashed")
    [ -z "${choice:-}" ] && return 0

    set_state processing
    if [ "$choice" = "Process all" ]; then
        setsid -f bash -c "
            if '$SCRIBE' recover --all >>'$LOG_FILE' 2>&1; then
                notify-send 'meeting-scribe' 'Crashed recordings recovered'
            else
                notify-send -u critical 'meeting-scribe' 'Recover failed (see $LOG_FILE)'
            fi
            echo idle > '$STATE_FILE'
            pkill -RTMIN+${BLOCK_SIGNAL} i3blocks 2>/dev/null || true
        " </dev/null >/dev/null 2>&1
    else
        id="${choice%% *}"
        setsid -f bash -c "
            if '$SCRIBE' recover '$id' >>'$LOG_FILE' 2>&1; then
                notify-send 'meeting-scribe' 'Recovered $id'
            else
                notify-send -u critical 'meeting-scribe' 'Recover failed (see $LOG_FILE)'
            fi
            echo idle > '$STATE_FILE'
            pkill -RTMIN+${BLOCK_SIGNAL} i3blocks 2>/dev/null || true
        " </dev/null >/dev/null 2>&1
    fi
}

handle_click() {
    case "$(current_state)" in
        idle)
            local count choice
            count=$(crashed_count)
            if [ "$count" -gt 0 ]; then
                choice=$(printf 'Record\nProcess crashed (%s)' "$count" \
                    | menu_pick "meeting-scribe")
                case "${choice:-}" in
                    Record) start_recording ;;
                    "Process crashed"*) process_crashed_menu ;;
                esac
            else
                start_recording
            fi
            ;;
        recording)
            local choice
            choice=$(printf 'stop\ncancel' | menu_pick "Recording")
            case "${choice:-}" in
                stop)
                    set_state processing
                    setsid -f bash -c "
                        if '$SCRIBE' stop >>'$LOG_FILE' 2>&1; then
                            notify-send 'meeting-scribe' 'Notes generated'
                        else
                            notify-send -u critical 'meeting-scribe' 'Stop failed (see $LOG_FILE)'
                        fi
                        echo idle > '$STATE_FILE'
                        pkill -RTMIN+${BLOCK_SIGNAL} i3blocks 2>/dev/null || true
                    " </dev/null >/dev/null 2>&1
                    ;;
                cancel)
                    if "$SCRIBE" cancel >>"$LOG_FILE" 2>&1; then
                        notify-send "meeting-scribe" "Recording cancelled"
                    else
                        notify-send -u critical "meeting-scribe" "Cancel failed (see $LOG_FILE)"
                    fi
                    set_state idle
                    ;;
            esac
            ;;
        processing)
            notify-send "meeting-scribe" "Already processing — please wait"
            ;;
    esac
}

case "${BLOCK_BUTTON:-0}" in
    3) handle_click ;;
esac

reconcile_state
state="$(current_state)"
case "$state" in
    recording) echo "🔴" ;;
    processing) echo "⏳" ;;
    *)
        if [ "$(crashed_count)" -gt 0 ]; then
            echo "⚠"
        else
            echo "🎙"
        fi
        ;;
esac
