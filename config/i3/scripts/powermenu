#!/usr/bin/env bash

#
# powermenu - a very simple rofi powermenu
#
# Copyright (C) 2025 Johannes Kamprad
#
# SPDX-License-Identifier: GPL-3.0-or-later

# Define the path to your i3 session save script
I3_SAVE_SCRIPT="${HOME}/.local/bin/save_i3_session.sh"

ROFI_THEME="${HOME}/.config/rofi/powermenu.rasi"
# Define possible lock scripts/commands (edit this list as you like)
LOCK_SCRIPTS=("${HOME}/.config/i3/scripts/blur-lock" "i3lock")

# Find available lock script
find_lock_script() {
  for script in "${LOCK_SCRIPTS[@]}"; do
    # Handle command names vs full paths
    if [[ "$script" =~ ^[a-zA-Z0-9_-]+$ ]]; then
      # It's a command name, check if available
      if command -v "$script" >/dev/null 2>&1; then
        echo "$script"
        return 0
      fi
    else
      # It's a path, check if file exists and is executable
      if [[ -x "$script" ]]; then
        echo "$script"
        return 0
      fi
    fi
  done
  return 1
}

# Every destructive session action saves the whole desktop first.
save="💾 Save session now"
status="ℹ Session save status"
cancel=" Cancel"
lock=" Lock"
logout=" Logout"
reboot=" Reboot"
shutdown=" Shutdown"

options="$cancel\n$save\n$status\n$logout\n$reboot\n$shutdown"
if lockcmd="$(find_lock_script)"; then
  options="$cancel\n$lock\n$save\n$status\n$logout\n$reboot\n$shutdown"
fi

chosen="$(printf '%b\n' "$options" | rofi -dmenu -i -p "Power Menu" -theme "$ROFI_THEME")"
session="$HOME/.local/bin/desktop-session"
case "$chosen" in
  "$lock") "$lockcmd" ;;
  "$save") "$I3_SAVE_SCRIPT" ;;
  "$status") "$session" status --notify ;;
  "$logout") "$session" power logout ;;
  "$reboot") "$session" power reboot ;;
  "$shutdown") "$session" power shutdown ;;
  "$cancel" | "") exit 0 ;;
esac
