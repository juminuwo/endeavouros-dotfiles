#!/usr/bin/env bash
# project-switch — group kitty windows on i3 ws6 (misc) + ws7 (claude) into
# named projects and swap them as a unit using i3 workspace renames.
#
# State model:
#   active project   -> windows on workspaces literally named "6" and "7"
#   inactive project -> windows on workspaces named "_proj_<name>_misc"
#                       and "_proj_<name>_claude" (hidden because i3 only
#                       displays a workspace when it's focused)
#   per-window mark  -> "proj:<name>:<role>" (role ∈ {claude, misc}); marks
#                       are the canonical project identity, survive renames
#
# Switching is a single chained i3-msg of `rename workspace` ops — no
# container moves, no floating round-trip, layout fully preserved.
#
# Subcommands: ensure-default | list | current | switch [name] |
#              switch-next | new [name] | rename [new] | reconcile

set -euo pipefail

LOG="/tmp/project-switch.log"
LOCK="/tmp/project-switch.lock"
HISTORY_FILE="${XDG_CACHE_HOME:-$HOME/.cache}/project-switch/history"
DEFAULT_PROJECT="scratch"
WS_CLAUDE=7
WS_MISC=6
SIGNAL_PROJECT=5    # i3blocks RTMIN+5 — [project] block
SIGNAL_WORKSPACES=11 # i3blocks RTMIN+11 — [workspaces] block
ROFI_CFG="$HOME/.config/rofi/rofidmenu.rasi"

# ---------------------------------------------------------------------------
# helpers
# ---------------------------------------------------------------------------

_log() { printf '%s %s\n' "$(date -Iseconds)" "$*" >>"$LOG"; }

_die() {
    local msg="$*"
    _log "ERROR: $msg"
    printf 'project-switch: %s\n' "$msg" >&2
    command -v notify-send >/dev/null && notify-send -u critical -t 30000 "project-switch" "$msg" || true
    exit 1
}

# Strip trailing whitespace from any proj:* marks (works around i3 including
# leading whitespace into the mark name when commands are chained with ';').
_normalize_marks() {
    local raw
    raw=$(i3-msg -t get_tree | jq -r '
        [.. | objects | select(.marks // [] | any(test("^proj:.+:[^ :]+[ \t]+$")))]
        | map(.id as $id | .marks[] | select(test("^proj:.+:[^ :]+[ \t]+$")) | [$id, .] | @tsv)
        | .[]
    ' 2>/dev/null || true)
    [[ -z "$raw" ]] && return 0
    while IFS=$'\t' read -r conid bad_mark; do
        [[ -z "$conid" ]] && continue
        local clean; clean=$(printf '%s' "$bad_mark" | sed -E 's/[[:space:]]+$//')
        _log "normalize: con_id=$conid '$bad_mark' -> '$clean'"
        i3-msg -- "[con_id=$conid] unmark" >/dev/null
        i3-msg -- "[con_id=$conid] mark --add $clean" >/dev/null
    done <<<"$raw"
}

# Serialize state-mutating subcommands so rapid Mod+y mashing doesn't race.
_lock() {
    exec 9>"$LOCK"
    flock -w 5 9 || _die "could not acquire lock $LOCK"
}

_signal_i3blocks() {
    pkill -RTMIN+$SIGNAL_PROJECT i3blocks 2>/dev/null || true
    pkill -RTMIN+$SIGNAL_WORKSPACES i3blocks 2>/dev/null || true
}

_ws_for_role() {
    case "$1" in
        claude) echo "$WS_CLAUDE" ;;
        misc)   echo "$WS_MISC" ;;
        *) _die "unknown role: $1" ;;
    esac
}

_hidden_ws_name() {
    # $1 = project name, $2 = role
    printf '_proj_%s_%s' "$1" "$2"
}

_validate_name() {
    local n="$1"
    [[ -n "$n" ]] || _die "project name is empty"
    [[ "$n" =~ ^[A-Za-z0-9._-]+$ ]] || _die "invalid project name: '$n' (allowed: A-Z a-z 0-9 . _ -)"
    [[ "$n" != *:* ]] || _die "project name cannot contain ':'"
}

_marks_all() {
    i3-msg -t get_marks | jq -r '.[]' | grep '^proj:' || true
}

_project_names() {
    _marks_all | sed 's/^proj:\([^:]*\):.*$/\1/' | sort -u
}

_mark_exists() {
    _marks_all | grep -Fxq "$1"
}

# Per-user file holding project names in last-accessed order, most recent
# first. Updated on every successful switch / new / rename. Survives across
# i3 restarts so the rofi picker doesn't reset to alphabetical on relogin.
_history_touch() {
    local name="$1"
    [[ -n "$name" ]] || return 0
    mkdir -p "$(dirname "$HISTORY_FILE")"
    local tmp; tmp=$(mktemp)
    {
        printf '%s\n' "$name"
        [[ -f "$HISTORY_FILE" ]] && grep -Fxv -- "$name" "$HISTORY_FILE" || true
    } >"$tmp"
    mv "$tmp" "$HISTORY_FILE"
}

_history_remove() {
    local name="$1"
    [[ -n "$name" ]] || return 0
    [[ -f "$HISTORY_FILE" ]] || return 0
    local tmp; tmp=$(mktemp)
    grep -Fxv -- "$name" "$HISTORY_FILE" >"$tmp" || true
    mv "$tmp" "$HISTORY_FILE"
}

# Emit existing project names ordered by last access (recent first); any
# project not yet in history is appended at the end in alphabetical order.
_history_order() {
    local known; known=$(_project_names)
    [[ -z "$known" ]] && return 0
    local seen=""
    if [[ -f "$HISTORY_FILE" ]]; then
        while IFS= read -r name; do
            [[ -z "$name" ]] && continue
            if grep -Fxq -- "$name" <<<"$known"; then
                printf '%s\n' "$name"
                seen+="$name"$'\n'
            fi
        done <"$HISTORY_FILE"
    fi
    while IFS= read -r name; do
        [[ -z "$name" ]] && continue
        grep -Fxq -- "$name" <<<"$seen" && continue
        printf '%s\n' "$name"
    done <<<"$known"
}

# Walk the i3 tree and emit `con_id<TAB>workspace<TAB>mark` for every window
# carrying a `proj:*` mark. Used by reconcile/dedupe.
_proj_windows() {
    i3-msg -t get_tree | jq -r '
        [.. | objects | select(.type == "workspace")]
        | map(.name as $ws | [.. | objects | select(.window != null and (.marks // [] | any(startswith("proj:"))))]
            | map([.id, $ws, (.marks | map(select(startswith("proj:")))[0])] | @tsv)
        )
        | flatten | .[]
    ' 2>/dev/null || true
}

# Active project is whichever proj:<name>:<role> mark sits on the workspace
# literally named "6" or "7".
_current_project() {
    _proj_windows | awk -v c="$WS_CLAUDE" -v m="$WS_MISC" '
        $2 == c || $2 == m { sub(/^proj:/, "", $3); sub(/:.*/, "", $3); print $3 }
    ' | sort -u | head -n1
}

# Currently focused workspace name (across all outputs).
_focused_ws() {
    i3-msg -t get_workspaces | jq -r '.[] | select(.focused) | .name' 2>/dev/null | head -n1
}

# True if a workspace by this name currently exists.
_ws_exists() {
    i3-msg -t get_workspaces | jq -e --arg n "$1" '.[] | select(.name == $n)' >/dev/null 2>&1
}

# Detect duplicate marks (shouldn't happen, but i3 4.x permits it).
_dedupe_marks() {
    _proj_windows | awk -F'\t' '{ count[$3]++; ids[$3] = ids[$3]" "$1 } END {
        for (m in count) if (count[m] > 1) {
            split(ids[m], arr, " ")
            kept = ""
            for (i in arr) {
                if (arr[i] == "") continue
                if (kept == "") { kept = arr[i]; continue }
                printf "[con_id=%s] unmark %s\n", arr[i], m
            }
        }
    }' | while read -r cmd; do
        [[ -n "$cmd" ]] || continue
        _log "dedupe: $cmd"
        i3-msg -- "$cmd" >/dev/null
    done
}

# Spawn a new kitty window on the role's active workspace (6 or 7), then mark
# it. for_window is config-only and rejected at runtime by i3-msg, so we poll
# get_tree for the unique WM_CLASS instead.
_spawn_role() {
    local name="$1" role="$2"
    local ws; ws=$(_ws_for_role "$role")
    local uuid; uuid=$(tr -dc 'a-f0-9' </proc/sys/kernel/random/uuid | head -c 16)
    local cls="kitty-proj-spawn-$uuid"
    local mark="proj:$name:$role"

    _log "spawn role=$role name=$name ws=$ws cls=$cls"

    setsid kitty --class "$cls" --title "$mark" >/dev/null 2>&1 9>&- &
    disown || true

    local con_id="" i
    for i in $(seq 1 100); do
        con_id=$(i3-msg -t get_tree | jq -r --arg c "$cls" '
            [.. | objects | select(.window_properties.instance == $c or .window_properties.class == $c)][0].id // empty
        ' 2>/dev/null || true)
        if [[ -n "$con_id" ]]; then
            i3-msg -- "[con_id=$con_id] mark --add $mark, move container to workspace number $ws, floating disable" >/dev/null
            _log "spawn ok: $mark con_id=$con_id (after $((i*50))ms)"
            return 0
        fi
        sleep 0.05
    done
    _die "spawn timeout: kitty class=$cls did not appear within 5s"
}

# Adopt an existing unmarked kitty window on a workspace into the current
# project. Used by ensure-default on cold start.
_adopt_on_workspace() {
    local name="$1" role="$2" ws; ws=$(_ws_for_role "$role")
    local con_id
    con_id=$(i3-msg -t get_tree | jq -r --arg ws "$ws" '
        [.. | objects | select(.type == "workspace" and .name == $ws)][0]
        | [.. | objects | select(
              .window != null
              and (.window_properties.class // "" | ascii_downcase | contains("kitty"))
              and ((.marks // []) | map(startswith("proj:")) | any | not)
          )][0].id // empty
    ' 2>/dev/null || true)

    if [[ -n "$con_id" ]]; then
        _log "adopt con_id=$con_id ws=$ws role=$role -> proj:$name:$role"
        i3-msg -- "[con_id=$con_id] mark --add proj:$name:$role" >/dev/null
        return 0
    fi
    return 1
}

# Stash the active project (whose windows are on ws6/ws7) by renaming those
# workspaces to their hidden names.
_stash_active() {
    local name="$1"
    local hm; hm=$(_hidden_ws_name "$name" misc)
    local hc; hc=$(_hidden_ws_name "$name" claude)
    i3-msg -- "rename workspace ${WS_MISC} to ${hm}; rename workspace ${WS_CLAUDE} to ${hc}" >/dev/null
}

# Ensure an inactive project's windows are parked on its hidden workspaces.
# Used to migrate windows stashed in the i3 scratchpad (legacy state from
# the previous scratchpad-based implementation) or any other location.
# Idempotent: if the windows are already on the right hidden workspace, the
# move is a no-op.
_ensure_hidden_parked() {
    local name="$1"
    local hm; hm=$(_hidden_ws_name "$name" misc)
    local hc; hc=$(_hidden_ws_name "$name" claude)
    i3-msg -- "[con_mark=\"^proj:${name}:misc\$\"]   move container to workspace ${hm}, floating disable" >/dev/null 2>&1 || true
    i3-msg -- "[con_mark=\"^proj:${name}:claude\$\"] move container to workspace ${hc}, floating disable" >/dev/null 2>&1 || true
}

# ---------------------------------------------------------------------------
# subcommands
# ---------------------------------------------------------------------------

cmd_ensure_default() {
    _lock
    _normalize_marks
    if [[ -n "$(_marks_all)" ]]; then
        _log "ensure-default: marks already exist, no-op"
        return 0
    fi
    _log "ensure-default: bootstrapping '$DEFAULT_PROJECT'"
    _adopt_on_workspace "$DEFAULT_PROJECT" claude || _spawn_role "$DEFAULT_PROJECT" claude
    _adopt_on_workspace "$DEFAULT_PROJECT" misc   || _spawn_role "$DEFAULT_PROJECT" misc
    _history_touch "$DEFAULT_PROJECT"
    _signal_i3blocks
}

cmd_list() {
    local current; current=$(_current_project || true)
    _project_names | while read -r name; do
        [[ -z "$name" ]] && continue
        if [[ "$name" == "$current" ]]; then
            printf '%s (active)\n' "$name"
        else
            printf '%s\n' "$name"
        fi
    done
}

cmd_current() {
    local c; c=$(_current_project || true)
    [[ -n "$c" ]] || exit 1
    printf '%s\n' "$c"
}

# Adopt any unmarked kitty already on ws6/ws7 into the current project,
# spawning only as a fallback. Self-healing.
#
# Adoption matters because users often open extra kitty windows on ws6/ws7
# via $mod+Return (or any other route outside project-switch). Without this,
# every switch-away-and-back would see no proj:<current>:<role> mark and
# spawn a duplicate kitty alongside the orphan.
cmd_reconcile() {
    local current; current=$(_current_project || true)
    [[ -n "$current" ]] || { _log "reconcile: no current project"; return 0; }
    _dedupe_marks
    for role in claude misc; do
        if ! _mark_exists "proj:$current:$role"; then
            if _adopt_on_workspace "$current" "$role"; then
                _log "reconcile: adopted unmarked kitty for role=$role into $current"
            else
                _log "reconcile: missing role=$role for $current — spawning"
                _spawn_role "$current" "$role"
            fi
        fi
    done
}

# Atomic switch via workspace renames: stash current to hidden names,
# surface target's hidden workspaces as 6/7. No window movement.
_do_switch() {
    local target="$1"
    local current; current=$(_current_project || true)

    if [[ "$target" == "$current" ]]; then
        _log "switch: target == current ($target), no-op"
        return 0
    fi

    # Verify target exists (its hidden workspaces should hold its windows).
    if ! _mark_exists "proj:$target:claude" && ! _mark_exists "proj:$target:misc"; then
        _die "no such project: $target"
    fi

    local target_hm; target_hm=$(_hidden_ws_name "$target" misc)
    local target_hc; target_hc=$(_hidden_ws_name "$target" claude)

    # Migration / self-heal: if the target's hidden workspaces don't exist
    # yet (e.g. windows are still in the legacy scratchpad), pull the
    # marked windows onto them. The subsequent rename then succeeds.
    if ! _ws_exists "$target_hm" || ! _ws_exists "$target_hc"; then
        _log "switch: migrating '$target' windows to hidden workspaces"
        _ensure_hidden_parked "$target"
    fi

    # Capture focus so we can re-display 6/7 after the rename if user was
    # looking at one of them. (Renames don't change what an output displays.)
    local focused; focused=$(_focused_ws)
    local refocus=""
    case "$focused" in
        "$WS_MISC"|"$WS_CLAUDE") refocus="$focused" ;;
    esac

    local cmd=""
    if [[ -n "$current" ]]; then
        local cur_hm; cur_hm=$(_hidden_ws_name "$current" misc)
        local cur_hc; cur_hc=$(_hidden_ws_name "$current" claude)
        cmd+="rename workspace ${WS_MISC} to ${cur_hm}; "
        cmd+="rename workspace ${WS_CLAUDE} to ${cur_hc}; "
    fi
    cmd+="rename workspace ${target_hm} to ${WS_MISC}; "
    cmd+="rename workspace ${target_hc} to ${WS_CLAUDE}"
    if [[ -n "$refocus" ]]; then
        cmd+="; workspace number ${refocus}"
    fi

    _log "switch: '$current' -> '$target' (refocus=${refocus:-none})"
    i3-msg -- "$cmd" >/dev/null
    _history_touch "$target"
}

cmd_switch() {
    local target="${1:-}"
    if [[ -z "$target" ]]; then
        local current; current=$(_current_project || true)
        # Order: most-recently-accessed first, the active project last (just
        # above the action items) so its label is one keystroke away from
        # the new/rename/delete entries the user usually wants alongside it.
        local menu=""
        while IFS= read -r name; do
            [[ -z "$name" ]] && continue
            [[ "$name" == "$current" ]] && continue
            menu+="$name"$'\n'
        done < <(_history_order)
        if [[ -n "$current" ]]; then
            menu+="$current (active)"$'\n'
        fi
        menu+="[ new project ]"
        if [[ -n "$current" ]]; then
            menu+=$'\n'"[ rename '${current}' ]"
            menu+=$'\n'"[ delete '${current}' ]"
        fi

        local sel
        sel=$(printf '%s\n' "$menu" | rofi -dmenu -i -p "project" -config "$ROFI_CFG" 2>/dev/null || true)
        [[ -n "$sel" ]] || { _log "switch: cancelled"; return 0; }

        case "$sel" in
            "[ new project ]")      cmd_new; return ;;
            "[ rename '"*"' ]")     cmd_rename; return ;;
            "[ delete '"*"' ]")     cmd_delete; return ;;
        esac
        target=$(printf '%s' "$sel" | sed 's/ (active)$//')
    fi
    _lock
    _validate_name "$target"
    _do_switch "$target"
    cmd_reconcile
    _signal_i3blocks
}

cmd_switch_next() {
    _lock
    local current; current=$(_current_project || true)
    local names; names=$(_project_names)
    [[ -n "$names" ]] || return 0
    local target
    target=$(printf '%s\n' "$names" | awk -v c="$current" '
        BEGIN { found=0; first=""; nxt="" }
        { if (first == "") first=$0; if (found == 1 && nxt == "") nxt=$0; if ($0 == c) found=1 }
        END { print (nxt != "" ? nxt : first) }
    ')
    [[ "$target" == "$current" ]] && return 0
    _do_switch "$target"
    cmd_reconcile
    _signal_i3blocks
}

cmd_new() {
    _lock
    local name="${1:-}"
    if [[ -z "$name" ]]; then
        name=$(printf '' | rofi -dmenu -p "new project" -config "$ROFI_CFG" 2>/dev/null || true)
        [[ -n "$name" ]] || { _log "new: cancelled"; return 0; }
    fi
    _validate_name "$name"

    if _project_names | grep -Fxq "$name"; then
        _die "project '$name' already exists"
    fi

    # Stash the current pair to hidden workspaces so 6/7 are free for spawn.
    local current; current=$(_current_project || true)
    if [[ -n "$current" ]]; then
        _stash_active "$current"
    fi

    _spawn_role "$name" claude
    _spawn_role "$name" misc

    _history_touch "$name"
    _signal_i3blocks
    _log "new: created '$name'"
}

cmd_delete() {
    _lock
    local target="${1:-}"
    local current; current=$(_current_project || true)
    if [[ -z "$target" ]]; then
        target="$current"
    fi
    [[ -n "$target" ]] || _die "no project specified and no current project"

    if ! _project_names | grep -Fxq "$target"; then
        _die "no such project: $target"
    fi

    local count; count=$(_project_names | wc -l)
    if [[ "$count" -le 1 ]]; then
        _die "cannot delete '$target': it is the only project (create another first)"
    fi

    # If deleting the active project, swap to a fallback first so the kill
    # happens against an inactive project — its windows are on hidden
    # workspaces, which disappear cleanly when emptied.
    if [[ "$target" == "$current" ]]; then
        local fallback
        fallback=$(_project_names | grep -vFx "$target" | head -n1)
        [[ -n "$fallback" ]] || _die "internal: no fallback found (target=$target)"
        _do_switch "$fallback"
    fi

    # Send kill by mark. If kitty has running processes (e.g., claude-code,
    # a server) it shows its close-confirmation overlay and ignores the
    # close request — visible because the marks remain.
    _log "delete: sending kill for '$target'"
    i3-msg -- "[con_mark=\"^proj:${target}:.*\$\"] kill" >/dev/null

    local i after=0
    for i in $(seq 1 15); do
        sleep 0.1
        after=$(_marks_all | grep -c "^proj:${target}:" || true)
        [[ "$after" -eq 0 ]] && break
    done

    if [[ "$after" -gt 0 ]]; then
        _log "delete: blocked by kitty close-confirmation (still=$after); aborting"
        command -v notify-send >/dev/null && \
            notify-send -t 30000 "project-switch" \
                "Delete '$target' blocked — kitty is showing a close confirmation (running processes). Answer it, then try again." || true
        return 0
    fi

    _history_remove "$target"
    _signal_i3blocks
    _log "delete: completed '$target'"
}

cmd_rename() {
    _lock
    local current; current=$(_current_project || true)
    [[ -n "$current" ]] || _die "no current project to rename"

    local newname="${1:-}"
    if [[ -z "$newname" ]]; then
        newname=$(printf '%s' "$current" | rofi -dmenu -p "rename '$current' ->" -config "$ROFI_CFG" 2>/dev/null || true)
        [[ -n "$newname" ]] || { _log "rename: cancelled"; return 0; }
    fi
    _validate_name "$newname"

    [[ "$newname" == "$current" ]] && return 0
    if _project_names | grep -Fxq "$newname"; then
        _die "project '$newname' already exists"
    fi

    # Rewrite marks (active project lives on 6/7 — workspace names don't change).
    for role in claude misc; do
        local oldmark="proj:${current}:${role}"
        local newmark="proj:${newname}:${role}"
        local conid
        conid=$(i3-msg -t get_tree | jq -r --arg m "$oldmark" '
            [.. | objects | select(.marks // [] | any(. == $m))][0].id // empty
        ' 2>/dev/null || true)
        [[ -n "$conid" ]] || continue
        i3-msg -- "[con_id=$conid] unmark"               >/dev/null
        i3-msg -- "[con_id=$conid] mark --add $newmark"  >/dev/null
    done

    _history_remove "$current"
    _history_touch  "$newname"
    _log "rename: '$current' -> '$newname'"
    _signal_i3blocks
}

# ---------------------------------------------------------------------------
# main
# ---------------------------------------------------------------------------

main() {
    local sub="${1:-}"
    [[ $# -gt 0 ]] && shift || true
    case "$sub" in
        ensure-default) cmd_ensure_default "$@" ;;
        list)           cmd_list "$@" ;;
        current)        cmd_current "$@" ;;
        switch)         cmd_switch "$@" ;;
        switch-next)    cmd_switch_next "$@" ;;
        new)            cmd_new "$@" ;;
        rename)         cmd_rename "$@" ;;
        delete)         cmd_delete "$@" ;;
        reconcile)      _lock; cmd_reconcile "$@" ;;
        ""|-h|--help|help)
            cat <<EOF
project-switch — i3+kitty project pair manager

Usage:
  project-switch ensure-default     idempotent bootstrap (run from i3 exec_always)
  project-switch list               list all projects (current marked active)
  project-switch current            print active project name
  project-switch switch [name]      switch to project (rofi picker if name omitted)
  project-switch switch-next        cycle to next project
  project-switch new [name]         create a new project pair
  project-switch rename [new]       rename current project
  project-switch delete [name]      kill both windows for project (default: current)
  project-switch reconcile          respawn missing role windows for current
EOF
            ;;
        *) _die "unknown subcommand: $sub (try --help)" ;;
    esac
}

main "$@"
