#!/usr/bin/env python3
"""Approval-gated scanner for syncing host drift into endeavouros-dotfiles."""

from __future__ import annotations

import argparse
import ast
import datetime as dt
import fcntl
import hashlib
import json
import os
import re
import shutil
import subprocess
import sys
from contextlib import contextmanager
from pathlib import Path
from typing import Iterable


REPO = Path(__file__).resolve().parents[2]
DEFAULT_STATE_DIR = Path(os.environ.get("DOTFILES_AUTOUPDATE_STATE_DIR", "~/.cache/dotfiles-autoupdate")).expanduser()
UNIT_SUFFIXES = {".service", ".timer", ".target"}
APPROVE_MESSAGE = "approve dotfiles"
DISCORD_APPROVAL_CHAT = "1506284995818553374"
DISCORD_INBOUND_RE = re.compile(
    r"^(?P<ts>\d{4}-\d{2}-\d{2} \d{2}:\d{2}:\d{2},\d+) "
    r".*inbound message: .*platform=discord .*user=isitokaymimi "
    r"chat=(?P<chat>\S+) msg=(?P<msg>'.*?'|\".*?\") reply_to_id="
)
PACKAGE_NAME_RE = re.compile(r"^[A-Za-z0-9@._+-]+$")
PACKAGE_ACTION_MANIFESTS = {
    "extra_native": "config/packages-repo.txt",
    "extra_foreign": "config/packages-aur.txt",
}
SILENT_ONLY_REPO_STATUS_PATHS = {
    "config/codex-config.toml",
    "config/fcitx5/profile",
}


def run(cmd: list[str], *, cwd: Path | None = None, check: bool = True) -> subprocess.CompletedProcess[str]:
    return subprocess.run(cmd, cwd=str(cwd) if cwd else None, check=check, text=True, stdout=subprocess.PIPE, stderr=subprocess.PIPE)


def sha256_file(path: Path) -> str:
    return hashlib.sha256(path.read_bytes()).hexdigest()


def current_head(repo: Path) -> str:
    return run(["git", "rev-parse", "HEAD"], cwd=repo).stdout.strip()


def current_branch(repo: Path) -> str:
    return run(["git", "branch", "--show-current"], cwd=repo).stdout.strip()


def remote_url(repo: Path) -> str:
    result = run(["git", "remote", "get-url", "origin"], cwd=repo, check=False)
    return result.stdout.strip() if result.returncode == 0 else ""


def git_status_lines(repo: Path) -> list[str]:
    result = run(["git", "status", "--porcelain=v1", "--untracked-files=all"], cwd=repo)
    return [line for line in result.stdout.splitlines() if line.strip()]


def status_path(status_line: str) -> str:
    path = status_line[3:]
    if " -> " in path:
        path = path.split(" -> ", 1)[1]
    return path.strip()


def repo_state_sha256(repo: Path, status: Iterable[str]) -> str:
    digest = hashlib.sha256()
    for line in status:
        path = status_path(line)
        full_path = repo / path
        digest.update(line.encode())
        digest.update(b"\0")
        if full_path.is_symlink():
            digest.update(b"symlink\0")
            digest.update(os.readlink(full_path).encode())
        elif full_path.is_file():
            digest.update(b"file\0")
            digest.update(str(full_path.stat().st_mode & 0o7777).encode())
            digest.update(b"\0")
            digest.update(full_path.read_bytes())
        elif full_path.exists():
            digest.update(b"other\0")
            digest.update(str(full_path.stat().st_mode & 0o7777).encode())
        else:
            digest.update(b"missing")
        digest.update(b"\0")
    return digest.hexdigest()


@contextmanager
def state_lock(state_dir: Path):
    state_dir.mkdir(parents=True, exist_ok=True)
    with (state_dir / ".lock").open("a+") as lock:
        fcntl.flock(lock.fileno(), fcntl.LOCK_EX)
        try:
            yield
        finally:
            fcntl.flock(lock.fileno(), fcntl.LOCK_UN)


def is_ignored_manifest_line(line: str) -> bool:
    stripped = line.strip()
    return not stripped or stripped.startswith("#")


def read_package_manifest(path: Path) -> set[str]:
    if not path.exists():
        return set()
    return {line.strip() for line in path.read_text().splitlines() if not is_ignored_manifest_line(line)}


def explicit_packages(args: list[str]) -> set[str]:
    result = run(args, check=False)
    if result.returncode != 0:
        return set()
    return set(result.stdout.split())


def package_state_sha256(
    native_explicit: set[str],
    foreign_explicit: set[str],
    native_installed: set[str],
    foreign_installed: set[str],
) -> str:
    state = {
        "native_explicit": sorted(native_explicit),
        "foreign_explicit": sorted(foreign_explicit),
        "native_installed": sorted(native_installed),
        "foreign_installed": sorted(foreign_installed),
    }
    return hashlib.sha256(json.dumps(state, sort_keys=True).encode()).hexdigest()


def live_package_state_sha256() -> str:
    queries = [
        ["pacman", "-Qqen"],
        ["pacman", "-Qqem"],
        ["pacman", "-Qqn"],
        ["pacman", "-Qqm"],
    ]
    results: list[set[str]] = []
    for query in queries:
        result = run(query, check=False)
        if result.returncode != 0:
            raise RuntimeError(f"Package query failed: {' '.join(query)}")
        results.append(set(result.stdout.split()))
    return package_state_sha256(*results)


def load_link_entries(repo: Path) -> dict[str, str]:
    """Parse the simple dotbot link block shape used in install.conf.yaml.

    This intentionally avoids a PyYAML runtime dependency for a cron script.
    It supports the two forms present in this repo:
      ~/.zshrc: config/zshrc
      ~/git/CLAUDE.md:
        path: config/AGENTS.md
    """

    config = repo / "install.conf.yaml"
    links: dict[str, str] = {}
    if not config.exists():
        return links

    in_link_block = False
    pending_dest: str | None = None
    for raw in config.read_text().splitlines():
        if not raw.strip() or raw.lstrip().startswith("#"):
            continue
        indent = len(raw) - len(raw.lstrip(" "))
        stripped = raw.strip()

        if indent == 0 and stripped.startswith("- "):
            in_link_block = stripped == "- link:"
            pending_dest = None
            continue

        if not in_link_block:
            continue

        if indent == 4 and ":" in stripped:
            key, value = stripped.split(":", 1)
            dest = key.strip()
            value = value.strip()
            if value:
                links[dest] = value
                pending_dest = None
            else:
                pending_dest = dest
            continue

        if pending_dest and indent >= 6 and stripped.startswith("path:"):
            links[pending_dest] = stripped.split(":", 1)[1].strip()
            pending_dest = None

    return links


def expand_home(path: str, home: Path) -> Path:
    if path == "~":
        return home
    if path.startswith("~/"):
        return home / path[2:]
    return Path(path)


def scan_dotbot_links(repo: Path, home: Path) -> list[dict[str, str]]:
    issues: list[dict[str, str]] = []
    for dest, src in sorted(load_link_entries(repo).items()):
        dest_path = expand_home(dest, home)
        expected = (repo / src).resolve(strict=False)
        if not dest_path.exists() and not dest_path.is_symlink():
            issues.append({"dest": dest, "src": src, "status": "missing"})
            continue
        if not dest_path.is_symlink():
            issues.append({"dest": dest, "src": src, "status": "not-symlink"})
            continue
        actual = dest_path.resolve(strict=False)
        if actual != expected:
            issues.append({"dest": dest, "src": src, "status": "mismatched", "actual": str(actual), "expected": str(expected)})
    return issues


def scan_unit_scope(scope: str, repo: Path, repo_dir: Path, live_dir: Path) -> list[dict[str, str]]:
    drift: list[dict[str, str]] = []
    if not repo_dir.exists():
        return drift
    for repo_file in sorted(repo_dir.iterdir()):
        if not repo_file.is_file() or repo_file.suffix not in UNIT_SUFFIXES:
            continue
        live_file = live_dir / repo_file.name
        repo_rel = repo_file.relative_to(repo)
        entry = {
            "scope": scope,
            "name": repo_file.name,
            "repo_path": str(repo_rel),
            "live_path": str(live_file),
        }
        if not live_file.exists():
            drift.append({**entry, "status": "missing-live", "repo_sha256": sha256_file(repo_file), "live_sha256": ""})
            continue
        repo_hash = sha256_file(repo_file)
        live_hash = sha256_file(live_file)
        if repo_hash != live_hash:
            drift.append({**entry, "status": "drift", "repo_sha256": repo_hash, "live_sha256": live_hash})
    return drift


def scan_units(repo: Path, home: Path, system_dir: Path = Path("/etc/systemd/system")) -> list[dict[str, str]]:
    return [
        *scan_unit_scope("user", repo, repo / "config/host/systemd/user", home / ".config/systemd/user"),
        *scan_unit_scope("system", repo, repo / "config/host/systemd/system", system_dir),
    ]


def compare_packages(
    repo: Path,
    *,
    native_explicit: set[str] | None = None,
    foreign_explicit: set[str] | None = None,
    native_installed: set[str] | None = None,
    foreign_installed: set[str] | None = None,
) -> dict[str, object]:
    native_explicit = native_explicit if native_explicit is not None else explicit_packages(["pacman", "-Qqen"])
    foreign_explicit = foreign_explicit if foreign_explicit is not None else explicit_packages(["pacman", "-Qqem"])
    native_installed = native_installed if native_installed is not None else explicit_packages(["pacman", "-Qqn"])
    foreign_installed = foreign_installed if foreign_installed is not None else explicit_packages(["pacman", "-Qqm"])
    repo_native = read_package_manifest(repo / "config/packages-repo.txt") | read_package_manifest(repo / "config/host/packages-host-repo.txt")
    repo_foreign = read_package_manifest(repo / "config/packages-aur.txt")
    ignored_extra_native = read_package_manifest(repo / "config/host/packages-extra-native-baseline.txt")
    return {
        "report_only": True,
        "state_sha256": package_state_sha256(
            native_explicit,
            foreign_explicit,
            native_installed,
            foreign_installed,
        ),
        "extra_native": sorted(native_explicit - repo_native - ignored_extra_native),
        "extra_foreign": sorted(foreign_explicit - repo_foreign),
        "missing_native": sorted(repo_native - native_installed),
        "missing_foreign": sorted(repo_foreign - foreign_installed),
        "ignored_extra_native": sorted(native_explicit & ignored_extra_native),
    }


def package_has_drift(packages: dict[str, object]) -> bool:
    return any(packages.get(key) for key in ("extra_native", "extra_foreign", "missing_native", "missing_foreign"))


def scan_is_silent_only_repo_status(scan: dict[str, object]) -> bool:
    """Return True for volatile repo-only changes that should not notify."""

    status = [str(line) for line in scan.get("git_status") or []]
    packages = scan.get("package_drift") or {}
    return (
        bool(status)
        and all(status_path(line) in SILENT_ONLY_REPO_STATUS_PATHS for line in status)
        and not scan.get("unit_drift")
        and not scan.get("link_issues")
        and not package_has_drift(packages)
    )


def package_actions(packages: dict[str, object]) -> list[dict[str, object]]:
    actions: list[dict[str, object]] = []
    extra_native = sorted(str(item) for item in packages.get("extra_native") or [])
    if extra_native:
        actions.append({
            "type": "append_package_manifest",
            "manifest": PACKAGE_ACTION_MANIFESTS["extra_native"],
            "packages": extra_native,
            "source": "extra_native",
        })

    extra_foreign = sorted(str(item) for item in packages.get("extra_foreign") or [])
    if extra_foreign:
        actions.append({
            "type": "append_package_manifest",
            "manifest": PACKAGE_ACTION_MANIFESTS["extra_foreign"],
            "packages": extra_foreign,
            "source": "extra_foreign",
        })
    return actions


def missing_manifest_packages(path: Path, packages: Iterable[str]) -> list[str]:
    existing = read_package_manifest(path)
    missing = {package for package in packages if package not in existing}
    return sorted(missing)


def append_packages_to_manifest(path: Path, packages: Iterable[str]) -> bool:
    new_packages = missing_manifest_packages(path, packages)
    if not new_packages:
        return False

    text = path.read_text() if path.exists() else ""
    if text and not text.endswith("\n"):
        text += "\n"
    path.parent.mkdir(parents=True, exist_ok=True)
    path.write_text(text + "\n".join(new_packages) + "\n")
    return True


def validate_package_action(action: dict[str, object]) -> tuple[bool, str]:
    source = str(action.get("source") or "")
    manifest = str(action.get("manifest") or "")
    if PACKAGE_ACTION_MANIFESTS.get(source) != manifest:
        return False, f"Unexpected package manifest action: {manifest}"

    packages = [str(package) for package in action.get("packages") or []]
    if not packages:
        return False, "Package manifest action has no packages."
    invalid = [package for package in packages if not PACKAGE_NAME_RE.match(package)]
    if invalid:
        return False, "Invalid package names in approved action: " + ", ".join(invalid[:8])
    return True, ""


def make_request_id(scan_basis: str) -> str:
    stamp = dt.datetime.now(dt.timezone.utc).strftime("%Y%m%dT%H%M%SZ")
    digest = hashlib.sha256(scan_basis.encode()).hexdigest()[:8]
    return f"{stamp}-{digest}"


def build_scan(
    *,
    repo: Path = REPO,
    home: Path = Path.home(),
    system_dir: Path = Path("/etc/systemd/system"),
    native_explicit: set[str] | None = None,
    foreign_explicit: set[str] | None = None,
    native_installed: set[str] | None = None,
    foreign_installed: set[str] | None = None,
) -> dict[str, object]:
    repo = repo.resolve()
    status = git_status_lines(repo)
    units = scan_units(repo, home, system_dir)
    links = scan_dotbot_links(repo, home)
    packages = compare_packages(
        repo,
        native_explicit=native_explicit,
        foreign_explicit=foreign_explicit,
        native_installed=native_installed,
        foreign_installed=foreign_installed,
    )

    repo_actions = [{"type": "commit_repo_changes", "status": status}] if status else []
    unit_actions = [
        {"type": "sync_live_unit", **entry}
        for entry in units
        if entry["status"] == "drift"
    ]
    pkg_actions = package_actions(packages)
    actions = [*repo_actions, *unit_actions, *pkg_actions]
    actionable = bool(actions or links or package_has_drift(packages))
    scan_basis_parts = [
        *status,
        *[json.dumps(item, sort_keys=True) for item in units + links],
    ]
    if package_has_drift(packages):
        scan_basis_parts.append(json.dumps(packages, sort_keys=True))
    scan_basis = "\n".join(scan_basis_parts)
    request_id = make_request_id(scan_basis or current_head(repo))

    return {
        "id": request_id,
        "created_at": dt.datetime.now(dt.timezone.utc).isoformat(),
        "repo": str(repo),
        "branch": current_branch(repo),
        "head": current_head(repo),
        "remote": remote_url(repo),
        "git_status": status,
        "repo_state_sha256": repo_state_sha256(repo, status),
        "unit_drift": units,
        "link_issues": links,
        "package_drift": packages,
        "actions": actions,
        "actionable": actionable,
    }


def bullet_list(items: Iterable[str], *, limit: int = 12) -> list[str]:
    values = list(items)
    shown = [f"- {item}" for item in values[:limit]]
    if len(values) > limit:
        shown.append(f"- … {len(values) - limit} more")
    return shown


def inline_list(items: Iterable[str], *, limit: int = 4) -> str:
    values = [str(item) for item in items]
    shown = ", ".join(values[:limit])
    if len(values) > limit:
        shown += f", +{len(values) - limit} more"
    return shown


def format_package_section(packages: dict[str, object]) -> list[str]:
    if not package_has_drift(packages):
        return []
    lines = ["", "Package comparison:"]
    labels = [
        ("installed native packages missing from repo manifests", "extra_native"),
        ("installed AUR/foreign packages missing from repo manifest", "extra_foreign"),
        ("repo native packages not installed on this machine", "missing_native"),
        ("repo AUR packages not installed on this machine", "missing_foreign"),
    ]
    for label, key in labels:
        values = packages.get(key) or []
        lines.append(f"- {label}: {len(values)}")
        if values:
            lines.extend(f"  - {item}" for item in values)
    if packages.get("extra_foreign"):
        lines.extend([
            "",
            "Review AUR package ownership, PKGBUILDs, and install scripts before approving.",
        ])
    return lines


def format_discord_message(scan: dict[str, object]) -> str:
    status = scan.get("git_status") or []
    units = scan.get("unit_drift") or []
    links = scan.get("link_issues") or []
    packages = scan.get("package_drift") or {}
    units_to_sync = [entry for entry in units if entry["status"] == "drift"]
    units_notify_only = [entry for entry in units if entry["status"] != "drift"]
    extra_native = packages.get("extra_native") or []
    extra_foreign = packages.get("extra_foreign") or []
    missing_native = packages.get("missing_native") or []
    missing_foreign = packages.get("missing_foreign") or []
    can_update_repo = bool(scan.get("actions"))

    if can_update_repo:
        lines = ["The dotfiles repo is behind this machine.", "", "Proposed repo update:"]
        if status:
            lines.append("- Changed repo files:")
            for entry in status:
                lines.append(f"  - `{entry[:2]}` {entry[3:]}")
        if units_to_sync:
            names = inline_list(entry["name"] for entry in units_to_sync)
            lines.append(f"- Copied systemd units changed: {names}")
        if extra_native:
            lines.append(f"- Native packages to record: {inline_list(extra_native)}")
        if extra_foreign:
            lines.append(
                f"- AUR packages to record: {inline_list(extra_foreign)} "
                "(review PKGBUILDs before approving)"
            )
    else:
        lines = ["This machine and the dotfiles repo differ.", "", "Review-only drift:"]

    notify_only: list[str] = []
    if units_notify_only:
        notify_only.append(
            f"systemd units not syncable: {inline_list(entry['name'] for entry in units_notify_only)}"
        )
    if links:
        notify_only.append(f"dotbot link issues: {len(links)}")
    if missing_native:
        notify_only.append(f"repo native packages not installed: {inline_list(missing_native)}")
    if missing_foreign:
        notify_only.append(f"repo AUR packages not installed: {inline_list(missing_foreign)}")
    if notify_only:
        if can_update_repo:
            lines.extend(["", "Review only (approval will not change these):"])
        lines.extend(f"- {item}" for item in notify_only)

    if can_update_repo:
        lines.extend([
            "",
            "Approve updating the repo and pushing to `main`?",
            "Reply `approve dotfiles`. Ignore this message to do nothing.",
            "The next scan replaces this snapshot; there is no approval queue.",
        ])
    else:
        lines.extend([
            "",
            "No automatic repo update is available. Reply `show dotfiles` for full details; no approval is needed.",
        ])
    return "\n".join(lines).strip() + "\n"


def format_snapshot_details(scan: dict[str, object]) -> str:
    request_id = str(scan["id"])
    lines = [f"Dotfiles snapshot: {request_id}", ""]

    status = scan.get("git_status") or []
    if status:
        lines.append("Repo working-tree changes:")
        lines.extend(bullet_list(status, limit=len(status)))
        lines.append("")

    units = scan.get("unit_drift") or []
    if units:
        lines.append("Copied systemd unit comparison:")
        for entry in units:
            lines.append(f"- {entry['status']}: {entry['live_path']} -> {entry['repo_path']}")
        lines.append("")

    links = scan.get("link_issues") or []
    if links:
        lines.append("Dotbot link issues (review only; approval does not run ./install):")
        for entry in links:
            lines.append(f"- {entry['status']}: {entry['dest']} -> {entry['src']}")

    lines.extend(format_package_section(scan.get("package_drift") or {}))
    if scan.get("actions"):
        lines.extend([
            "",
            "Reply `approve dotfiles` to apply this snapshot, commit it, and push `main`.",
        ])
    else:
        lines.extend([
            "",
            "This snapshot has no automatic repo update. No approval is needed.",
        ])
    return "\n".join(lines).strip() + "\n"


def pending_path(state_dir: Path = DEFAULT_STATE_DIR) -> Path:
    return state_dir / "pending.json"


def save_pending(scan: dict[str, object], state_dir: Path = DEFAULT_STATE_DIR) -> Path:
    path = pending_path(state_dir)
    path.parent.mkdir(parents=True, exist_ok=True)
    path.write_text(json.dumps(scan, indent=2, sort_keys=True) + "\n")
    return path


def load_pending(state_dir: Path = DEFAULT_STATE_DIR) -> dict[str, object]:
    path = pending_path(state_dir)
    if not path.exists():
        raise FileNotFoundError("No pending dotfiles snapshot")
    return json.loads(path.read_text())


def clear_pending(state_dir: Path = DEFAULT_STATE_DIR) -> None:
    path = pending_path(state_dir)
    if path.exists():
        path.unlink()


def request_created_local(request: dict[str, object]) -> dt.datetime:
    created = str(request.get("created_at") or "1970-01-01T00:00:00+00:00")
    parsed = dt.datetime.fromisoformat(created)
    if parsed.tzinfo is None:
        return parsed
    return parsed.astimezone().replace(tzinfo=None)


def discord_inbound_messages(log_path: Path) -> list[dict[str, object]]:
    if not log_path.exists():
        return []
    messages: list[dict[str, object]] = []
    for line in log_path.read_text(errors="replace").splitlines():
        match = DISCORD_INBOUND_RE.search(line)
        if not match:
            continue
        try:
            message = ast.literal_eval(match.group("msg"))
            timestamp = dt.datetime.strptime(match.group("ts"), "%Y-%m-%d %H:%M:%S,%f")
        except (SyntaxError, ValueError):
            continue
        messages.append({
            "timestamp": timestamp,
            "chat": match.group("chat"),
            "message": message,
        })
    return messages


def find_discord_approval(
    *,
    state_dir: Path = DEFAULT_STATE_DIR,
    log_path: Path = Path("~/.hermes/logs/gateway.log").expanduser(),
) -> dict[str, str] | None:
    try:
        request = load_pending(state_dir)
    except FileNotFoundError:
        return None
    if not request.get("actions"):
        return None

    for event in reversed(discord_inbound_messages(log_path)):
        message = str(event["message"])
        approved_at = event["timestamp"]
        if (
            event["chat"] == DISCORD_APPROVAL_CHAT
            and message == APPROVE_MESSAGE
            and approved_at >= request_created_local(request)
        ):
            return {"request_id": str(request["id"]), "mode": "current-snapshot", "message": message}

    return None


def validate_repo(repo: Path) -> list[str]:
    checks: list[str] = []
    diff_check = run(["git", "diff", "--check"], cwd=repo, check=False)
    if diff_check.returncode != 0:
        raise RuntimeError("git diff --check failed:\n" + diff_check.stdout + diff_check.stderr)
    checks.append("git diff --check")

    script = repo / "config/bin/dotfiles-autoupdate"
    if script.exists():
        compile_check = run([sys.executable, "-m", "py_compile", str(script)], check=False)
        if compile_check.returncode != 0:
            raise RuntimeError("py_compile failed:\n" + compile_check.stdout + compile_check.stderr)
        checks.append("python -m py_compile config/bin/dotfiles-autoupdate")

    unit_files = [str(path) for path in (repo / "config/host/systemd/user").glob("*") if path.suffix in UNIT_SUFFIXES]
    if unit_files and shutil.which("systemd-analyze"):
        verify = run(["systemd-analyze", "--user", "verify", *unit_files], check=False)
        if verify.returncode != 0:
            raise RuntimeError("systemd-analyze --user verify failed:\n" + verify.stdout + verify.stderr)
        checks.append("systemd-analyze --user verify config/host/systemd/user/*")

    return checks


def retry_pending_push(
    request: dict[str, object],
    repo: Path,
    *,
    dry_run: bool,
) -> dict[str, object]:
    commit = str(request.get("push_pending_commit") or "")
    paths = sorted(str(path) for path in request.get("push_pending_paths") or [])
    branch = current_branch(repo)
    if branch != request.get("branch") or branch != "main":
        return {"ok": False, "error": "Branch changed while a push retry was pending; manual recovery is required."}
    if remote_url(repo) != str(request.get("remote") or ""):
        return {"ok": False, "error": "Git origin changed while a push retry was pending; manual recovery is required."}
    if current_head(repo) != commit:
        return {"ok": False, "error": "HEAD changed while a push retry was pending; manual recovery is required."}
    if git_status_lines(repo):
        return {"ok": False, "error": "Repo changed while a push retry was pending; manual recovery is required."}
    if dry_run:
        return {
            "ok": True,
            "dry_run": True,
            "checks": ["existing local commit is ready to retry"],
            "paths": paths,
            "commit": commit,
        }

    push = run(["git", "push", "origin", "main"], cwd=repo, check=False)
    if push.returncode != 0:
        return {
            "ok": False,
            "error": "git push origin main failed: " + (push.stderr.strip() or push.stdout.strip()),
            "retryable_push": True,
            "commit": commit,
            "paths": paths,
        }
    return {
        "ok": True,
        "checks": ["retried existing local commit"],
        "paths": paths,
        "push": push.stdout.strip(),
        "commit": commit,
    }


def save_push_retry(
    request: dict[str, object],
    result: dict[str, object],
    state_dir: Path,
) -> None:
    request["push_pending_commit"] = result["commit"]
    request["push_pending_paths"] = result["paths"]
    request["push_retry_notified"] = True
    save_pending(request, state_dir)


def apply_request(
    request: dict[str, object],
    *,
    repo: Path | None = None,
    dry_run: bool = False,
    package_state_override: str | None = None,
) -> dict[str, object]:
    repo = (repo or Path(str(request["repo"]))).resolve()
    if request.get("push_pending_commit"):
        return retry_pending_push(request, repo, dry_run=dry_run)

    branch = current_branch(repo)
    if branch != request.get("branch"):
        return {"ok": False, "error": "Branch changed since scan; re-run scan before applying."}
    if branch != "main":
        return {"ok": False, "error": "Dotfiles repo is not checked out to main; re-run the scan from clean main."}
    if current_head(repo) != request.get("head"):
        return {"ok": False, "error": "HEAD changed since scan; re-run scan before applying."}
    if remote_url(repo) != str(request.get("remote") or ""):
        return {"ok": False, "error": "Git origin changed since scan; re-run scan before applying."}

    planned_status = [str(line) for line in request.get("git_status") or []]
    planned_repo_state = str(request.get("repo_state_sha256") or "")
    if not planned_repo_state:
        return {"ok": False, "error": "Snapshot lacks a repo state fingerprint; re-run the scan before applying."}
    current_status = git_status_lines(repo)
    if current_status != planned_status:
        return {"ok": False, "error": "Repo status changed since scan; re-run scan before applying."}
    if repo_state_sha256(repo, current_status) != planned_repo_state:
        return {"ok": False, "error": "Repo contents changed since scan; re-run scan before applying."}

    package_actions_present = any(
        action.get("type") == "append_package_manifest"
        for action in request.get("actions", [])
    )
    if package_actions_present:
        expected_package_state = str((request.get("package_drift") or {}).get("state_sha256") or "")
        if not expected_package_state:
            return {"ok": False, "error": "Snapshot lacks a package state fingerprint; re-run the scan before applying."}
        try:
            current_package_state = package_state_override or live_package_state_sha256()
        except RuntimeError as exc:
            return {"ok": False, "error": str(exc)}
        if current_package_state != expected_package_state:
            return {"ok": False, "error": "Installed package state changed since scan; re-run scan before applying."}

    add_paths: set[str] = set()
    for action in request.get("actions", []):
        if action["type"] == "commit_repo_changes":
            add_paths.update(status_path(line) for line in action.get("status") or [])
        elif action["type"] == "sync_live_unit":
            live = Path(action["live_path"])
            repo_file = repo / action["repo_path"]
            if not live.exists():
                return {"ok": False, "error": f"Live unit disappeared: {live}"}
            if sha256_file(live) != action.get("live_sha256"):
                return {"ok": False, "error": f"Live unit changed since scan: {live}"}
            if not dry_run:
                repo_file.write_bytes(live.read_bytes())
            add_paths.add(str(repo_file.relative_to(repo)))
        elif action["type"] == "append_package_manifest":
            ok, error = validate_package_action(action)
            if not ok:
                return {"ok": False, "error": error}
            manifest_path = repo / str(action["manifest"])
            packages = [str(package) for package in action.get("packages") or []]
            if dry_run:
                if missing_manifest_packages(manifest_path, packages):
                    add_paths.add(str(action["manifest"]))
            elif append_packages_to_manifest(manifest_path, packages):
                add_paths.add(str(action["manifest"]))

    checks = validate_repo(repo)
    if dry_run:
        return {"ok": True, "dry_run": True, "checks": checks, "paths": sorted(add_paths)}

    if not add_paths:
        return {"ok": False, "error": "No approved paths to apply."}

    run(["git", "add", *sorted(add_paths)], cwd=repo)
    run(["git", "commit", "-m", "chore: sync dotfiles from host scan"], cwd=repo)
    commit = current_head(repo)
    push = run(["git", "push", "origin", "main"], cwd=repo, check=False)
    if push.returncode != 0:
        return {
            "ok": False,
            "error": "git push origin main failed: " + (push.stderr.strip() or push.stdout.strip()),
            "retryable_push": True,
            "commit": commit,
            "paths": sorted(add_paths),
        }
    status = git_status_lines(repo)
    if status:
        return {"ok": False, "error": "Commit pushed, but the local dotfiles repo is not clean: " + ", ".join(status[:8])}
    return {"ok": True, "checks": checks, "paths": sorted(add_paths), "push": push.stdout.strip(), "commit": commit}


def command_scan(args: argparse.Namespace) -> int:
    state_dir = Path(args.state_dir).expanduser()
    with state_lock(state_dir):
        try:
            pending = load_pending(state_dir)
        except FileNotFoundError:
            pending = {}
        if pending.get("push_pending_commit"):
            return 0
        scan = build_scan(repo=Path(args.repo), home=Path(args.home).expanduser(), system_dir=Path(args.system_dir))
        if not scan["actionable"] or scan_is_silent_only_repo_status(scan):
            clear_pending(state_dir)
            return 0
        save_pending(scan, state_dir)
    sys.stdout.write(format_discord_message(scan))
    return 0


def command_show(args: argparse.Namespace) -> int:
    state_dir = Path(args.state_dir).expanduser()
    with state_lock(state_dir):
        request = load_pending(state_dir)
    sys.stdout.write(format_snapshot_details(request))
    return 0


def command_reject(args: argparse.Namespace) -> int:
    state_dir = Path(args.state_dir).expanduser()
    with state_lock(state_dir):
        clear_pending(state_dir)
    print("Cleared the pending dotfiles snapshot")
    return 0


def command_apply(args: argparse.Namespace) -> int:
    state_dir = Path(args.state_dir).expanduser()
    with state_lock(state_dir):
        request = load_pending(state_dir)
        result = apply_request(request, dry_run=args.dry_run)
        if not result["ok"]:
            if result.get("retryable_push") and not args.dry_run:
                save_push_retry(request, result, state_dir)
            print(f"Dotfiles apply failed: {result['error']}", file=sys.stderr)
            return 1
        if not args.dry_run:
            clear_pending(state_dir)
    print(json.dumps(result, indent=2, sort_keys=True))
    return 0


def command_approvals(args: argparse.Namespace) -> int:
    state_dir = Path(args.state_dir).expanduser()
    with state_lock(state_dir):
        approval = find_discord_approval(state_dir=state_dir, log_path=Path(args.log_path).expanduser())
        if approval is None:
            return 0

        request = load_pending(state_dir)
        if str(request.get("id")) != approval["request_id"]:
            print("Dotfiles approval ignored because the pending snapshot changed; run a fresh scan.")
            return 0
        result = apply_request(request)
        if result.get("retryable_push"):
            already_notified = bool(request.get("push_retry_notified"))
            save_push_retry(request, result, state_dir)
            if already_notified:
                return 0
        elif request.get("push_pending_commit") and not result["ok"]:
            previous_blocker = str(request.get("push_blocker") or "")
            request["push_blocker"] = result["error"]
            save_pending(request, state_dir)
            if previous_blocker == result["error"]:
                return 0
        else:
            clear_pending(state_dir)
    if not result["ok"]:
        print(f"Dotfiles approval {approval['request_id']} failed: {result['error']}")
        return 0

    print(
        "Dotfiles approval applied and pushed.\n"
        f"Request: {approval['request_id']} ({approval['mode']})\n"
        f"Commit: {result['commit']}\n"
        "Paths:\n"
        + "\n".join(f"- {path}" for path in result["paths"])
    )
    return 0


def build_parser() -> argparse.ArgumentParser:
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("--repo", default=str(REPO))
    parser.add_argument("--home", default=str(Path.home()))
    parser.add_argument("--system-dir", default="/etc/systemd/system")
    parser.add_argument("--state-dir", default=str(DEFAULT_STATE_DIR))
    sub = parser.add_subparsers(dest="command")

    scan = sub.add_parser("scan", help="scan host drift and print a Discord approval request")
    scan.set_defaults(func=command_scan)

    show = sub.add_parser("show", help="show the current pending approval snapshot")
    show.set_defaults(func=command_show)

    reject = sub.add_parser("reject", help="clear the current pending approval snapshot")
    reject.set_defaults(func=command_reject)

    apply = sub.add_parser("apply", help="apply, commit, and push the current snapshot")
    apply.add_argument("--dry-run", action="store_true")
    apply.set_defaults(func=command_apply)

    approvals = sub.add_parser("approvals", help="check Discord DM history for approvals and apply one pending request")
    approvals.add_argument("--log-path", default="~/.hermes/logs/gateway.log")
    approvals.set_defaults(func=command_approvals)
    return parser


def main(argv: list[str] | None = None) -> int:
    parser = build_parser()
    args = parser.parse_args(argv)
    if args.command is None:
        args = parser.parse_args([*sys.argv[1:], "scan"])
    return args.func(args)


if __name__ == "__main__":
    raise SystemExit(main())
