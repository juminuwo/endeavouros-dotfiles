#!/usr/bin/env python3
"""Hermes shell hook: desktop notification when a CLI turn ends."""

from __future__ import annotations

import json
import os
import subprocess
import sys


def main() -> int:
    try:
        payload = json.load(sys.stdin)
    except Exception:
        payload = {}

    extra = payload.get("extra") or {}
    platform = extra.get("platform") or payload.get("platform") or ""

    # Avoid duplicate desktop notifications for gateway/mobile sessions; the
    # original request is for Hermes CLI parity with Claude/Codex desktop hooks.
    if platform and platform != "cli":
        print("{}")
        return 0

    completed = extra.get("completed")
    interrupted = extra.get("interrupted")

    if interrupted:
        message = "Hermes interrupted"
    elif completed is False:
        message = "Hermes stopped without a final response"
    else:
        message = "Hermes finished"

    env = os.environ.copy()
    env["title"] = "Hermes"
    env["message"] = message

    notify = os.path.expanduser("~/bin/claude-notify")
    subprocess.Popen(
        [notify],
        env=env,
        stdout=subprocess.DEVNULL,
        stderr=subprocess.DEVNULL,
        start_new_session=True,
    )

    print("{}")
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
