#!/usr/bin/env bash
# Spawn an `agents-dashboard` tab as tab 1 in the kitty OS window where a
# coding-agent session (Claude Code or Codex CLI) has just started — but
# only if one isn't already present in that OS window.
#
# Wired into both harnesses via their respective SessionStart hooks:
#   - Claude:  ~/.claude/settings.json     (hooks.SessionStart)
#   - Codex:   ~/.codex/config.toml        ([[hooks.session_start]])
# Silently exits when not running under a kitty instance with
# `listen_on` configured.

LOG="/tmp/agents-dashboard-spawn.log"

# Read the hook payload (JSON on stdin). Claude's payload has .session_id
# which we record so the dashboard can disambiguate multiple sessions in
# the same cwd. Codex's payload differs and we don't need it — the
# dashboard looks up Codex threads via ~/.codex/state_5.sqlite.
payload=$(cat 2>/dev/null || true)
session_id=""
if [ -n "$payload" ]; then
  session_id=$(printf '%s' "$payload" | jq -r '.session_id // empty' 2>/dev/null || true)
fi

# Walk up the process tree to find the parent agent process (claude|codex).
agent_pid=""
agent_kind=""
walk_pid=$$
while [ "${walk_pid:-0}" -gt 1 ]; do
  ppid=$(awk '{print $4}' "/proc/$walk_pid/stat" 2>/dev/null) || break
  [ -n "${ppid:-}" ] && [ "$ppid" -gt 1 ] || break
  comm=$(cat "/proc/$ppid/comm" 2>/dev/null) || break
  case "$comm" in
    claude) agent_pid="$ppid"; agent_kind="claude"; break ;;
    codex)  agent_pid="$ppid"; agent_kind="codex";  break ;;
  esac
  walk_pid="$ppid"
done

# Record the claude pid->session_id mapping (codex doesn't need this; the
# dashboard reads its session id straight from SQLite).
if [ "$agent_kind" = "claude" ] && [ -n "$agent_pid" ] && [ -n "$session_id" ]; then
  mkdir -p /tmp/claude-sessions 2>/dev/null
  printf '%s\n' "$session_id" > "/tmp/claude-sessions/$agent_pid"
  echo "$(date -Iseconds) recorded claude pid=$agent_pid -> session=$session_id" >>"$LOG"
fi

[ -n "${KITTY_LISTEN_ON:-}" ] || { echo "$(date -Iseconds) no KITTY_LISTEN_ON" >>"$LOG"; exit 0; }
[ -n "${KITTY_WINDOW_ID:-}" ] || { echo "$(date -Iseconds) no KITTY_WINDOW_ID" >>"$LOG"; exit 0; }

DASHBOARD_TITLE="agents-dashboard"
DASHBOARD_BIN="$HOME/.local/bin/agents-dashboard"

# Serialize so two parallel SessionStart hooks don't both spawn.
LOCK="/tmp/agents-dashboard-spawn-${KITTY_LISTEN_ON##*/}.lock"
exec 200>"$LOCK"
flock -n 200 || { echo "$(date -Iseconds) lock held, skipping (pid=$$)" >>"$LOG"; exit 0; }

echo "=== $(date -Iseconds) spawn (pid=$$) ===" >>"$LOG"

ls_json=$(kitty @ ls --to "$KITTY_LISTEN_ON" 2>>"$LOG") || { echo "kitty @ ls failed" >>"$LOG"; exit 0; }

exists=$(printf '%s' "$ls_json" | jq -r \
  --argjson wid "$KITTY_WINDOW_ID" \
  --arg title "$DASHBOARD_TITLE" '
    .[]
    | select(any(.tabs[].windows[]; .id == $wid))
    | .tabs
    | map(select(.title == $title))
    | length
  ' 2>>"$LOG" || echo 0)

echo "existing=$exists" >>"$LOG"
[ "${exists:-0}" -gt 0 ] && { echo "already present" >>"$LOG"; exit 0; }

# --copy-env so the new tab inherits the calling shell's PATH (incl. ~/.local/bin).
# uv is at ~/.local/bin/uv and is needed by the dashboard's shebang.
# --keep-focus so the dashboard opens in the background — claude tab keeps focus.
echo "launching: $DASHBOARD_BIN" >>"$LOG"
kitty @ launch \
  --to "$KITTY_LISTEN_ON" \
  --type=tab \
  --tab-title="$DASHBOARD_TITLE" \
  --location=first \
  --match "id:$KITTY_WINDOW_ID" \
  --copy-env \
  --keep-focus \
  "$DASHBOARD_BIN" >>"$LOG" 2>&1
echo "launch rc=$?" >>"$LOG"
