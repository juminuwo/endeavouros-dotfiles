#!/usr/bin/env -S uv run --quiet --script
# /// script
# requires-python = ">=3.12"
# dependencies = ["textual>=0.80"]
# ///
"""Agent session dashboard for Kitty (impala-style cards).

Lists active agent sessions (Claude Code, Codex CLI, Hermes) as cards.
Navigate with j/k or arrow keys; press Enter to focus local kitty-backed
sessions when a tab is known.
"""

from __future__ import annotations

import json
import logging
import os
import re
import sqlite3
import subprocess
import sys
import time
from datetime import datetime
from pathlib import Path

from rich.console import Group
from rich.table import Table
from rich.text import Text

from textual import work
from textual.app import App, ComposeResult
from textual.binding import Binding
from textual.containers import VerticalScroll
from textual.message import Message
from textual.reactive import reactive
from textual.widgets import Footer, Header, Static

# Claude Code on-disk layout.
CLAUDE_PROJECTS_DIR = Path.home() / ".claude" / "projects"
CLAUDE_SESSIONS_DIR = Path("/tmp") / "claude-sessions"
# Codex CLI on-disk layout: a SQLite index of threads + per-thread JSONL rollouts.
CODEX_STATE_DB = Path.home() / ".codex" / "state_5.sqlite"
# Hermes on-disk layout: SQLite session store shared by CLI and gateways.
HERMES_HOME = Path(os.environ.get("HERMES_HOME") or Path.home() / ".hermes")
HERMES_STATE_DB = HERMES_HOME / "state.db"
HERMES_LOG_PATH = HERMES_HOME / "logs" / "agent.log"
REFRESH_SECONDS = 2.0
TAIL_BYTES = 200_000
KITTY_TIMEOUT = 2.0
LOG_PATH = Path("/tmp") / f"agents-dashboard-{os.getuid()}.log"
CONFIG_DIR = Path(os.environ.get("XDG_CONFIG_HOME") or Path.home() / ".config") / "agents-dashboard"
THEME_FILE = CONFIG_DIR / "theme"

logging.basicConfig(
    filename=str(LOG_PATH),
    level=logging.INFO,
    format="%(asctime)s %(levelname)s %(message)s",
)
log = logging.getLogger("agents-dashboard")
HERMES_SESSION_RE = re.compile(r"\[(\d{8}_\d{6}_[0-9a-fA-F]+)\]")
HERMES_LOG_TS_RE = re.compile(r"^(\d{4}-\d{2}-\d{2} \d{2}:\d{2}:\d{2}),(\d{3})")


def _log_unhandled(exc_type, exc, tb):
    log.error("uncaught", exc_info=(exc_type, exc, tb))
    sys.__excepthook__(exc_type, exc, tb)


sys.excepthook = _log_unhandled


# --- kitty IPC -------------------------------------------------------------


def kitty_cmd(*args: str) -> list[str]:
    cmd = ["kitty", "@"]
    sock = os.environ.get("KITTY_LISTEN_ON")
    if sock:
        cmd += ["--to", sock]
    cmd += list(args)
    return cmd


def kitty_ls() -> list:
    try:
        r = subprocess.run(
            kitty_cmd("ls"),
            capture_output=True,
            text=True,
            check=False,
            timeout=KITTY_TIMEOUT,
        )
    except (subprocess.TimeoutExpired, FileNotFoundError):
        return []
    if r.returncode != 0:
        log.warning("kitty ls rc=%s stderr=%r", r.returncode, r.stderr[:200])
        return []
    try:
        return json.loads(r.stdout)
    except json.JSONDecodeError:
        return []


# --- session discovery ----------------------------------------------------


def harness_for_process(proc: dict) -> str | None:
    """Return 'claude', 'codex', 'hermes', or None for a kitty foreground process."""
    cmdline = proc.get("cmdline") or []
    if not cmdline:
        return None
    base = cmdline[0].rsplit("/", 1)[-1]
    if base == "claude":
        return "claude"
    if base == "codex":
        return "codex"
    if base in ("hermes", "tirith"):
        return "hermes"
    if base in ("node", "nodejs"):
        for arg in cmdline[1:]:
            if "claude" in arg and ("cli.js" in arg or "/share/claude/" in arg):
                return "claude"
    for arg in cmdline[1:]:
        if arg.endswith("/hermes") or "hermes_cli" in arg:
            return "hermes"
    return None


def proc_cwd(pid: int) -> str | None:
    try:
        return os.readlink(f"/proc/{pid}/cwd")
    except OSError:
        return None


def proc_start_time(pid: int) -> float | None:
    """Return process start time as a Unix timestamp."""
    try:
        stat = Path(f"/proc/{pid}/stat").read_text()
        rparen = stat.rfind(")")
        fields = stat[rparen + 2 :].split()
        start_ticks = int(fields[19])
        ticks_per_second = os.sysconf(os.sysconf_names["SC_CLK_TCK"])
        for line in Path("/proc/stat").read_text().splitlines():
            if line.startswith("btime "):
                boot_time = int(line.split()[1])
                return boot_time + (start_ticks / ticks_per_second)
    except (OSError, ValueError, IndexError, KeyError):
        return None
    return None


def encode_cwd(path: str) -> str:
    return path.replace("/", "-")


# --- Claude Code session lookup -------------------------------------------


def claude_session_id_for_pid(pid: int) -> str | None:
    """Look up the session-id recorded by the SessionStart hook for this pid."""
    f = CLAUDE_SESSIONS_DIR / str(pid)
    if not f.is_file():
        return None
    try:
        return f.read_text().strip() or None
    except OSError:
        return None


def claude_jsonl_by_id(cwd: str, session_id: str) -> Path | None:
    j = CLAUDE_PROJECTS_DIR / encode_cwd(cwd) / f"{session_id}.jsonl"
    return j if j.is_file() else None


def claude_jsonl_fallback(cwd: str) -> Path | None:
    """Most recently modified JSONL in this cwd. Used when no pid mapping exists."""
    pd = CLAUDE_PROJECTS_DIR / encode_cwd(cwd)
    if not pd.exists():
        return None
    jsonls = [p for p in pd.glob("*.jsonl") if p.is_file()]
    if not jsonls:
        return None
    return max(jsonls, key=lambda p: p.stat().st_mtime)


def cleanup_stale_claude_session_files() -> None:
    """Drop pid->session mappings for processes that no longer exist."""
    if not CLAUDE_SESSIONS_DIR.exists():
        return
    try:
        entries = list(CLAUDE_SESSIONS_DIR.iterdir())
    except OSError:
        return
    for f in entries:
        if not f.is_file():
            continue
        try:
            pid = int(f.name)
        except ValueError:
            continue
        if not Path(f"/proc/{pid}").exists():
            try:
                f.unlink()
            except OSError:
                pass


# --- Codex CLI session lookup ---------------------------------------------


def codex_rollout_for_pid(pid: int) -> Path | None:
    """Find the rollout JSONL that this codex process has open as a file
    descriptor. This disambiguates multiple codex sessions sharing a cwd
    (the previous "most recently updated in cwd" heuristic collapsed them
    into one). No hook approval needed — codex always keeps its rollout
    open for writing.
    """
    fd_dir = Path(f"/proc/{pid}/fd")
    try:
        entries = list(fd_dir.iterdir())
    except OSError:
        return None
    for fd in entries:
        try:
            target = os.readlink(fd)
        except OSError:
            continue
        # Codex stores rollouts at ~/.codex/sessions/YYYY/MM/DD/rollout-*.jsonl
        if "/.codex/sessions/" in target and target.endswith(".jsonl"):
            p = Path(target)
            return p if p.is_file() else None
    return None


def codex_thread_id_for_rollout(rollout: Path) -> str | None:
    """Look up the SQLite thread id matching this rollout path."""
    if not CODEX_STATE_DB.is_file():
        return None
    try:
        con = sqlite3.connect(f"file:{CODEX_STATE_DB}?mode=ro", uri=True, timeout=0.5)
        try:
            row = con.execute(
                "SELECT id FROM threads WHERE rollout_path = ? LIMIT 1",
                (str(rollout),),
            ).fetchone()
        finally:
            con.close()
    except sqlite3.Error as e:
        log.warning("codex sqlite read failed: %s", e)
        return None
    return row[0] if row else None


def codex_session_for_pid(pid: int, cwd: str) -> tuple[str | None, Path | None]:
    """Return (thread_id, rollout_path) for this codex process.

    Primary path: read /proc/<pid>/fd/ to find the rollout JSONL the
    process has open — unique per session. Fallback when fd inspection
    fails (permissions, race at startup): most-recently-updated thread
    in cwd, which is correct when only one codex per cwd is running.
    """
    rollout = codex_rollout_for_pid(pid)
    if rollout:
        tid = codex_thread_id_for_rollout(rollout)
        return (tid, rollout)
    # Fallback: cwd lookup
    if not CODEX_STATE_DB.is_file():
        return (None, None)
    try:
        con = sqlite3.connect(f"file:{CODEX_STATE_DB}?mode=ro", uri=True, timeout=0.5)
        try:
            row = con.execute(
                "SELECT id, rollout_path FROM threads "
                "WHERE cwd = ? AND archived = 0 "
                "ORDER BY updated_at DESC LIMIT 1",
                (cwd,),
            ).fetchone()
        finally:
            con.close()
    except sqlite3.Error as e:
        log.warning("codex sqlite read failed: %s", e)
        return (None, None)
    if not row:
        return (None, None)
    tid, rp = row
    p = Path(rp) if rp else None
    return (tid, p if (p and p.is_file()) else None)


# --- per-harness session iteration ----------------------------------------


def find_agent_tabs():
    cleanup_stale_claude_session_files()
    seen_pids: set[int] = set()
    for osw in kitty_ls():
        for tab in osw.get("tabs", []):
            for win in tab.get("windows", []):
                for proc in win.get("foreground_processes", []):
                    harness = harness_for_process(proc)
                    if not harness:
                        continue
                    pid = proc.get("pid")
                    if not pid or pid in seen_pids:
                        continue
                    cwd = proc_cwd(pid) or win.get("cwd", "")
                    if not cwd:
                        continue
                    jsonl: Path | None
                    sid: str | None
                    if harness == "claude":
                        sid = claude_session_id_for_pid(pid)
                        if sid:
                            # Trust the hook mapping. If the session hasn't
                            # written its JSONL yet, show empty rather than
                            # lying with newest-in-cwd.
                            jsonl = claude_jsonl_by_id(cwd, sid)
                        else:
                            jsonl = claude_jsonl_fallback(cwd)
                    elif harness == "codex":
                        sid, jsonl = codex_session_for_pid(pid, cwd)
                    else:  # hermes
                        sid, summary = hermes_session_for_pid(pid)
                        jsonl = None
                    seen_pids.add(pid)
                    tab_info = {
                        "harness": harness,
                        "tab_id": tab["id"],
                        "window_id": win.get("id"),
                        "cwd": cwd,
                        "jsonl": jsonl,
                        "session_id": sid,
                        "pid": pid,
                    }
                    if harness == "hermes":
                        tab_info["summary"] = summary
                    yield tab_info
                    break


def tail_lines(p: Path, max_bytes: int = TAIL_BYTES) -> list[str]:
    try:
        size = p.stat().st_size
        with p.open("rb") as f:
            f.seek(max(0, size - max_bytes))
            data = f.read()
    except OSError:
        return []
    return data.decode("utf-8", errors="ignore").split("\n")


def claude_session_summary(j: Path) -> dict:
    last_user = last_assistant = last_tool = last_recap = ""
    for line in tail_lines(j):
        if not line.strip():
            continue
        try:
            rec = json.loads(line)
        except json.JSONDecodeError:
            continue
        rt = rec.get("type")
        if rt == "user":
            content = rec.get("message", {}).get("content")
            if isinstance(content, list):
                for it in content:
                    if isinstance(it, dict) and it.get("type") == "text":
                        text = it.get("text") or ""
                        if text and not text.startswith("<"):
                            last_user = text
            elif isinstance(content, str) and content and not content.startswith("<"):
                last_user = content
        elif rt == "assistant":
            content = rec.get("message", {}).get("content") or []
            if isinstance(content, list):
                for it in content:
                    if not isinstance(it, dict):
                        continue
                    if it.get("type") == "text":
                        text = (it.get("text") or "").strip()
                        if text:
                            last_assistant = text
                    elif it.get("type") == "tool_use":
                        last_tool = it.get("name") or last_tool
        elif rt == "system" and rec.get("subtype") == "away_summary":
            content = rec.get("content") or ""
            if isinstance(content, str) and content.strip():
                last_recap = content.strip()
    # Strip the trailing "(disable recaps in /config)" hint Claude appends.
    if last_recap.endswith(")"):
        idx = last_recap.rfind("(disable recaps")
        if idx > 0:
            last_recap = last_recap[:idx].rstrip()
    return {
        "last_user": last_user,
        "last_assistant": last_assistant,
        "last_tool": last_tool,
        "last_recap": last_recap,
        "mtime": j.stat().st_mtime,
    }


def codex_session_summary(j: Path) -> dict:
    """Parse a Codex rollout JSONL. Codex uses typed event_msg records:
    user_message / agent_message; tool calls appear as response_item rows
    with role=tool or function_call payloads.
    """
    last_user = last_assistant = last_tool = ""
    for line in tail_lines(j):
        if not line.strip():
            continue
        try:
            rec = json.loads(line)
        except json.JSONDecodeError:
            continue
        rt = rec.get("type")
        payload = rec.get("payload") or {}
        if rt == "event_msg":
            et = payload.get("type")
            if et == "user_message":
                msg = payload.get("message") or ""
                if msg and not msg.startswith("<"):
                    last_user = msg
            elif et == "agent_message":
                msg = payload.get("message") or ""
                if msg:
                    last_assistant = msg.strip()
        elif rt == "response_item":
            # Tool/function calls land as response_item with type=function_call
            # (shell, apply_patch, MCP tools all flow through this shape).
            it_type = payload.get("type")
            if it_type == "function_call":
                name = payload.get("name") or ""
                if name:
                    last_tool = name
    return {
        "last_user": last_user,
        "last_assistant": last_assistant,
        "last_tool": last_tool,
        "last_recap": "",  # Codex recaps live in the TUI, not the rollout.
        "mtime": j.stat().st_mtime,
    }


def codex_recap_from_text(text: str) -> str:
    """Read the latest Codex recap cell from plain Kitty scrollback.

    Rich mode has a ruled heading and indented, wrapped body; raw mode
    has a plain heading. A blank line or the next cell ends the body.
    """
    lines = text.splitlines()
    for index in range(len(lines) - 1, -1, -1):
        heading = lines[index].strip()
        rich = bool(re.fullmatch(r"─ Conversation recap(?: ─*)?", heading))
        if not rich and heading != "Conversation recap":
            continue
        body = []
        for line in lines[index + 1:]:
            stripped = line.strip()
            if not stripped:
                if body:
                    break
                continue
            if rich and not line.startswith("  "):
                break
            if stripped.startswith(("›", "─", "•", "■")):
                break
            body.append(stripped)
        return " ".join(body)
    return ""


def codex_window_recap(window_id: int) -> str:
    try:
        result = subprocess.run(
            kitty_cmd("get-text", "--match", f"id:{window_id}", "--extent", "all"),
            capture_output=True,
            text=True,
            check=False,
            timeout=KITTY_TIMEOUT,
        )
    except (subprocess.TimeoutExpired, OSError):
        return ""
    if result.returncode != 0:
        return ""
    return codex_recap_from_text(result.stdout)


def _parse_hermes_log_timestamp(line: str) -> float | None:
    match = HERMES_LOG_TS_RE.match(line)
    if not match:
        return None
    try:
        dt = datetime.strptime(
            f"{match.group(1)}.{match.group(2)}", "%Y-%m-%d %H:%M:%S.%f"
        )
    except ValueError:
        return None
    return dt.timestamp()


def hermes_log_session_ids_since(start_time: float | None) -> list[str]:
    """Return newest unique Hermes session ids seen in logs after start_time."""
    ids: list[str] = []
    seen: set[str] = set()
    cutoff = (start_time - 5.0) if start_time is not None else None
    for line in reversed(tail_lines(HERMES_LOG_PATH)):
        if cutoff is not None:
            ts = _parse_hermes_log_timestamp(line)
            if ts is None or ts < cutoff:
                continue
        match = HERMES_SESSION_RE.search(line)
        if not match:
            continue
        sid = match.group(1)
        if sid in seen:
            continue
        ids.append(sid)
        seen.add(sid)
    return ids


def _hermes_session_row(session_id: str) -> sqlite3.Row | None:
    if not HERMES_STATE_DB.is_file():
        return None
    try:
        con = sqlite3.connect(f"file:{HERMES_STATE_DB}?mode=ro", uri=True, timeout=0.5)
        con.row_factory = sqlite3.Row
        try:
            row = con.execute(
                """
                SELECT
                    s.id,
                    s.source,
                    s.model,
                    s.started_at,
                    s.title,
                    s.message_count,
                    s.tool_call_count,
                    COALESCE(MAX(m.timestamp), s.started_at) AS last_active,
                    (
                        SELECT content FROM messages
                        WHERE session_id = s.id
                          AND role = 'user'
                          AND COALESCE(content, '') != ''
                        ORDER BY timestamp DESC
                        LIMIT 1
                    ) AS last_user,
                    (
                        SELECT content FROM messages
                        WHERE session_id = s.id
                          AND role = 'assistant'
                          AND COALESCE(content, '') != ''
                        ORDER BY timestamp DESC
                        LIMIT 1
                    ) AS last_assistant,
                    (
                        SELECT tool_name FROM messages
                        WHERE session_id = s.id
                          AND role = 'tool'
                          AND COALESCE(tool_name, '') != ''
                        ORDER BY timestamp DESC
                        LIMIT 1
                    ) AS last_tool
                FROM sessions s
                LEFT JOIN messages m ON m.session_id = s.id
                WHERE s.id = ?
                  AND s.ended_at IS NULL
                  AND s.source = 'cli'
                GROUP BY s.id
                LIMIT 1
                """,
                (session_id,),
            ).fetchone()
        finally:
            con.close()
    except sqlite3.Error as e:
        log.warning("hermes sqlite read failed: %s", e)
        return None
    return row


def _latest_hermes_cli_session_row() -> sqlite3.Row | None:
    if not HERMES_STATE_DB.is_file():
        return None
    try:
        con = sqlite3.connect(f"file:{HERMES_STATE_DB}?mode=ro", uri=True, timeout=0.5)
        con.row_factory = sqlite3.Row
        try:
            row = con.execute(
                """
                SELECT
                    s.id,
                    s.source,
                    s.model,
                    s.started_at,
                    s.title,
                    s.message_count,
                    s.tool_call_count,
                    COALESCE(MAX(m.timestamp), s.started_at) AS last_active,
                    (
                        SELECT content FROM messages
                        WHERE session_id = s.id
                          AND role = 'user'
                          AND COALESCE(content, '') != ''
                        ORDER BY timestamp DESC
                        LIMIT 1
                    ) AS last_user,
                    (
                        SELECT content FROM messages
                        WHERE session_id = s.id
                          AND role = 'assistant'
                          AND COALESCE(content, '') != ''
                        ORDER BY timestamp DESC
                        LIMIT 1
                    ) AS last_assistant,
                    (
                        SELECT tool_name FROM messages
                        WHERE session_id = s.id
                          AND role = 'tool'
                          AND COALESCE(tool_name, '') != ''
                        ORDER BY timestamp DESC
                        LIMIT 1
                    ) AS last_tool
                FROM sessions s
                LEFT JOIN messages m ON m.session_id = s.id
                WHERE s.ended_at IS NULL
                  AND s.source = 'cli'
                GROUP BY s.id
                ORDER BY last_active DESC
                LIMIT 1
                """
            ).fetchone()
        finally:
            con.close()
    except sqlite3.Error as e:
        log.warning("hermes sqlite read failed: %s", e)
        return None
    return row


def _hermes_summary_from_row(row: sqlite3.Row) -> dict:
    activity_bits = []
    if row["model"]:
        activity_bits.append(row["model"])
    if row["message_count"]:
        activity_bits.append(f"{row['message_count']} msgs")
    if row["tool_call_count"]:
        activity_bits.append(f"{row['tool_call_count']} tools")
    activity = " · ".join(activity_bits)
    return {
        "last_user": row["last_user"] or "",
        "last_assistant": row["last_assistant"] or activity,
        "last_tool": row["last_tool"] or "",
        "last_recap": "",
        "mtime": row["last_active"] or row["started_at"] or time.time(),
        "title": row["title"] or row["source"] or "hermes",
    }


def hermes_session_for_pid(pid: int) -> tuple[str | None, dict | None]:
    """Resolve a live Hermes CLI process to its state.db session summary.

    Hermes no longer keeps a per-session JSONL open in current builds. The CLI
    writes tagged log lines with the session id, while messages live in state.db.
    """
    start_time = proc_start_time(pid)
    for sid in hermes_log_session_ids_since(start_time):
        row = _hermes_session_row(sid)
        if row:
            return sid, _hermes_summary_from_row(row)
    row = _latest_hermes_cli_session_row()
    if row:
        return row["id"], _hermes_summary_from_row(row)
    return (None, None)


def session_summary(j: Path, harness: str) -> dict:
    if harness == "codex":
        return codex_session_summary(j)
    return claude_session_summary(j)


# --- formatting -----------------------------------------------------------


def status_for(mtime: float) -> tuple[str, str, str]:
    """Return (label, emoji, rich_style)."""
    age = time.time() - mtime
    if age < 3:
        return ("working", "●", "bold #5ee066")
    if age < 30:
        return ("thinking", "●", "bold #f5b34a")
    if age < 300:
        return ("idle", "●", "bold #6ea3ff")
    return ("stale", "●", "dim #888888")


def fmt_age(mtime: float) -> str:
    age = int(time.time() - mtime)
    if age < 60:
        return f"{age}s ago"
    if age < 3600:
        return f"{age // 60}m ago"
    if age < 86400:
        return f"{age // 3600}h ago"
    return f"{age // 86400}d ago"


def truncate(s: str, n: int) -> str:
    s = " ".join(s.split())
    if n <= 1:
        return s[:n]
    return (s[: n - 1] + "…") if len(s) > n else s


def gather_sessions() -> list[dict]:
    out = []
    seen_hermes_session_ids: set[str] = set()
    for tab in find_agent_tabs():
        if tab["harness"] == "hermes" and tab.get("summary"):
            if tab.get("session_id") in seen_hermes_session_ids:
                continue
            if tab.get("session_id"):
                seen_hermes_session_ids.add(tab["session_id"])
            s = tab["summary"]
            fresh = False
        elif tab["jsonl"]:
            s = session_summary(tab["jsonl"], tab["harness"])
            fresh = False
        else:
            s = {
                "last_user": "",
                "last_assistant": "",
                "last_tool": "",
                "last_recap": "",
                "mtime": time.time(),
            }
            fresh = True
        if (
            tab["harness"] == "codex"
            and not fresh
            and tab.get("window_id") is not None
            and status_for(s["mtime"])[0] in ("idle", "stale")
        ):
            s["last_recap"] = codex_window_recap(tab["window_id"])
        project = Path(tab["cwd"]).name or tab["cwd"]
        if tab["harness"] == "hermes":
            project = s.get("title") or project
        out.append(
            {
                "tab_id": tab["tab_id"],
                "harness": tab["harness"],
                "session_id": tab.get("session_id"),
                "project": project,
                "cwd": tab["cwd"],
                "summary": s,
                "fresh": fresh,
            }
        )
    return sorted(out, key=lambda s: s["summary"]["mtime"], reverse=True)


def render_card(session: dict) -> Group:
    sm = session["summary"]
    fresh = session.get("fresh", False)

    if fresh:
        label, dot, style = ("new", "○", "bold #b89eff")
        age = "just started"
    else:
        label, dot, style = status_for(sm["mtime"])
        age = fmt_age(sm["mtime"])

    activity = sm["last_tool"] or sm["last_assistant"] or ("—" if not fresh else "waiting for first prompt")
    prompt = sm["last_user"] or ("(no messages yet)" if fresh else "(no prompt yet)")
    recap = sm.get("last_recap") or ""
    show_recap = bool(recap) and not fresh and label in ("idle", "stale")

    # Top row: harness badge + project (left) + status dot+label (right)
    top = Table.grid(expand=True, padding=(0, 0))
    top.add_column(ratio=1)
    top.add_column(justify="right")
    harness = session.get("harness", "claude")
    if harness == "codex":
        badge_style = "bold #ffb86c"
    elif harness == "hermes":
        badge_style = "bold #80cbc4"
    else:
        badge_style = "bold #b89eff"
    project_text = Text()
    project_text.append(f"{harness} ", style=badge_style)
    project_text.append(session["project"], style="bold #a8c7ff")
    status_text = Text()
    status_text.append(f"{dot} ", style=style)
    status_text.append(label, style=style)
    top.add_row(project_text, status_text)

    if show_recap:
        middle = Text()
        middle.append("recap: ", style="bold #c8a8ff")
        middle.append(truncate(recap, 240), style="#d0d0d0")
    else:
        middle_style = "italic dim #888888" if fresh else "italic #b8b8b8"
        middle = Text(f"“{truncate(prompt, 200)}”", style=middle_style)

    bottom = Table.grid(expand=True, padding=(0, 0))
    bottom.add_column(ratio=1)
    bottom.add_column(justify="right")
    bottom.add_row(
        Text(truncate(activity, 80), style="dim #909090" if fresh else "#7ec8ff"),
        Text(age, style="dim #909090"),
    )

    return Group(top, Text(""), middle, Text(""), bottom)


# --- widgets --------------------------------------------------------------


class SessionCard(Static):
    DEFAULT_CSS = """
    SessionCard {
        height: 7;
        border: round #3a3a4a;
        padding: 0 2;
        margin: 0 0 1 0;
        background: $surface;
    }
    SessionCard:hover {
        border: round #6a8aaa;
    }
    SessionCard.-selected {
        border: heavy #88c0ff;
        background: $boost;
    }
    """

    class Clicked(Message):
        def __init__(self, index: int) -> None:
            super().__init__()
            self.index = index

    def __init__(self, index: int = 0) -> None:
        super().__init__()
        self.index = index

    def on_click(self) -> None:
        self.post_message(self.Clicked(self.index))


class EmptyState(Static):
    DEFAULT_CSS = """
    EmptyState {
        height: 1fr;
        content-align: center middle;
        color: #707080;
        text-style: italic;
    }
    """


# --- app ------------------------------------------------------------------


class Dashboard(App):
    CSS = """
    Screen {
        background: $background;
    }

    #cards {
        padding: 1 2 0 2;
    }

    Header {
        background: $surface;
    }
    """

    BINDINGS = [
        Binding("q", "quit", "Quit"),
        Binding("r", "refresh_now", "Refresh"),
        Binding("j,down", "cursor_next", "↓"),
        Binding("k,up", "cursor_prev", "↑"),
        Binding("enter", "select", "Switch"),
    ]

    TITLE = "agents"

    cursor_index: reactive[int] = reactive(0)

    def __init__(self) -> None:
        super().__init__()
        self.sessions: list[dict] = []
        self.cards: list[SessionCard] = []

    def compose(self) -> ComposeResult:
        yield Header(show_clock=True, icon="")
        yield VerticalScroll(EmptyState("waiting for sessions…"), id="cards")
        yield Footer()

    def on_mount(self) -> None:
        try:
            saved = THEME_FILE.read_text().strip()
        except OSError:
            saved = ""
        if saved and saved in self.available_themes:
            self.theme = saved
        self.refresh_data()
        self.set_interval(REFRESH_SECONDS, self.refresh_data)

    def watch_theme(self, _old: str, new: str) -> None:
        try:
            CONFIG_DIR.mkdir(parents=True, exist_ok=True)
            THEME_FILE.write_text(new)
        except OSError as e:
            log.warning("could not save theme: %s", e)

    @work(thread=True, exclusive=True)
    def refresh_data(self) -> None:
        try:
            sessions = gather_sessions()
        except Exception as e:  # noqa: BLE001
            log.exception("refresh failed")
            self.call_from_thread(
                self.notify, f"refresh failed: {e}", severity="error"
            )
            return
        self.call_from_thread(self._apply_sessions, sessions)

    def _apply_sessions(self, sessions: list[dict]) -> None:
        scroll = self.query_one("#cards", VerticalScroll)
        prev_count = len(self.sessions)
        self.sessions = sessions

        if not sessions:
            for child in list(scroll.children):
                child.remove()
            scroll.mount(EmptyState("No active agent sessions."))
            self.cards = []
            self.sub_title = "0 active"
            return

        # If the count changed, rebuild cards. Otherwise just update content.
        if len(sessions) != len(self.cards) or prev_count == 0:
            for child in list(scroll.children):
                child.remove()
            self.cards = []
            for i, _ in enumerate(sessions):
                card = SessionCard(index=i)
                scroll.mount(card)
                self.cards.append(card)

        if self.cursor_index >= len(self.cards):
            self.cursor_index = max(0, len(self.cards) - 1)
        self._refresh_cards()
        self.sub_title = f"{len(sessions)} active"

    def _refresh_cards(self) -> None:
        for i, (card, s) in enumerate(zip(self.cards, self.sessions)):
            card.update(render_card(s))
            card.set_class(i == self.cursor_index, "-selected")

    def watch_cursor_index(self, _old: int, _new: int) -> None:
        if self.cards:
            self._refresh_cards()
            try:
                self.cards[self.cursor_index].scroll_visible(animate=False)
            except Exception:  # noqa: BLE001
                pass

    def action_cursor_next(self) -> None:
        if self.cards and self.cursor_index < len(self.cards) - 1:
            self.cursor_index += 1

    def action_cursor_prev(self) -> None:
        if self.cards and self.cursor_index > 0:
            self.cursor_index -= 1

    def action_select(self) -> None:
        if not self.cards or self.cursor_index >= len(self.sessions):
            return
        tab_id = self.sessions[self.cursor_index]["tab_id"]
        if tab_id is None:
            self.notify("No kitty tab is attached to this session.", severity="information")
            return
        try:
            subprocess.run(
                kitty_cmd("focus-tab", "--match", f"id:{tab_id}"),
                check=False,
                timeout=KITTY_TIMEOUT,
            )
        except (subprocess.TimeoutExpired, FileNotFoundError):
            self.notify("kitty focus-tab timed out", severity="warning")

    def action_refresh_now(self) -> None:
        self.refresh_data()

    def on_session_card_clicked(self, event: SessionCard.Clicked) -> None:
        if 0 <= event.index < len(self.sessions):
            self.cursor_index = event.index
            self.action_select()


if __name__ == "__main__":
    log.info("dashboard starting (pid=%d)", os.getpid())
    try:
        Dashboard().run()
    except Exception:
        log.exception("dashboard crashed")
        raise
    log.info("dashboard exited normally")
