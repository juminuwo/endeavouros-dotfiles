#!/usr/bin/env bash
# project-status — i3blocks block for the current project.
#
# Output: " <project>" (Nerd Font folder glyph) or "—" when no project.
# Click handlers are intentionally disabled — switching is keybind-only
# (see Mod+y in i3 config) to avoid signal-races with i3blocks refresh
# that left the displayed name stuck behind on the previous project.

set -euo pipefail

PROJECT_SWITCH="$HOME/.local/bin/project-switch"

current=$("$PROJECT_SWITCH" current 2>/dev/null || true)
if [[ -n "$current" ]]; then
    printf "<span foreground='#c4a7e7'> %s</span>\n" "$current"
else
    printf '—\n'
fi
