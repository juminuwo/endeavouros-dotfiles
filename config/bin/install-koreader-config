#!/bin/sh
set -eu

script_dir=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)
repo_root=$(CDPATH= cd -- "$script_dir/../.." && pwd)
config_home=${XDG_CONFIG_HOME:-"$HOME/.config"}
koreader_dir="$config_home/koreader"
settings_file="$koreader_dir/settings.reader.lua"

mkdir -p "$koreader_dir"

# KOReader rewrites settings.reader.lua as UI and per-device state changes. Seed
# portable defaults on a fresh install, but never replace an established device.
if [ ! -e "$settings_file" ]; then
    install -m 0644 \
        "$repo_root/config/koreader/settings.reader.lua" \
        "$settings_file"
fi
