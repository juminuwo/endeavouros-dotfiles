#!/bin/bash
# Check if clipboard actually contains image data before attempting to save
if ! xclip -selection clipboard -t TARGETS -o 2>/dev/null | grep -q 'image/png'; then
    notify-send "No image in clipboard" "Clipboard doesn't contain image data"
    exit 1
fi

FILE="/tmp/clipboard-$(date +%s).png"
xclip -selection clipboard -t image/png -o > "$FILE" 2>/dev/null
if [ $? -eq 0 ] && [ -s "$FILE" ]; then
    echo -n "$FILE" | xclip -selection clipboard
    notify-send "Clipboard image saved" "$FILE"
else
    rm -f "$FILE"
    notify-send "Failed to save image" "Could not extract image from clipboard"
fi
