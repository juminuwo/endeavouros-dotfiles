#!/bin/bash
# Save clipboard image to file for pasting into terminal AI agents.

TARGETS=$(xclip -selection clipboard -t TARGETS -o 2>/dev/null)

# Try image MIME types in order of preference
IMAGE_TYPE=""
for mime in image/png image/x-png image/bmp image/jpeg image/tiff; do
    if echo "$TARGETS" | grep -q "$mime"; then
        IMAGE_TYPE="$mime"
        break
    fi
done

if [ -z "$IMAGE_TYPE" ]; then
    notify-send "No image in clipboard" "Targets: $(echo "$TARGETS" | tr '\n' ' ')"
    exit 1
fi

FILE="/tmp/clipboard-$(date +%s).png"
xclip -selection clipboard -t "$IMAGE_TYPE" -o > "$FILE" 2>/dev/null
if [ $? -eq 0 ] && [ -s "$FILE" ]; then
    echo -n "$FILE" | xclip -selection clipboard
    notify-send "Clipboard image saved" "$FILE"
else
    rm -f "$FILE"
    notify-send "Failed to save image" "Type: $IMAGE_TYPE"
fi
