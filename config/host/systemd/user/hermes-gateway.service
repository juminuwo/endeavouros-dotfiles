[Unit]
Description=Hermes Gateway
StartLimitIntervalSec=0

[Service]
Type=simple
ExecStart=/home/howis/.hermes/hermes-agent/venv/bin/python -m hermes_cli.main gateway run --replace
WorkingDirectory=/home/howis/.hermes
Environment="PATH=/home/howis/.hermes/hermes-agent/venv/bin:/home/howis/.hermes/hermes-agent/node_modules/.bin:/home/howis/.nvm/versions/node/v25.2.1/bin:/home/howis/.local/bin:/home/howis/.cargo/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin"
Environment="VIRTUAL_ENV=/home/howis/.hermes/hermes-agent/venv"
Environment="HERMES_HOME=/home/howis/.hermes"
Restart=always
RestartSec=5
RestartMaxDelaySec=300
RestartSteps=5
RestartForceExitStatus=75
KillMode=mixed
KillSignal=SIGTERM
ExecReload=/bin/kill -USR1 $MAINPID
TimeoutStopSec=210
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=default.target
