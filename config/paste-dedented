#!/bin/bash
# Dedent the X11 clipboard (strip common leading whitespace), then paste it.
# Bound to Ctrl+Shift+Alt+v in i3.
#
# Terminals use Ctrl+Shift+V for paste (Ctrl+V is a control char), so detect
# the focused window class and dispatch the right keystroke.

xclip -selection clipboard -o \
  | python3 -c '
import sys, textwrap
lines = [l.rstrip() for l in textwrap.dedent(sys.stdin.read()).splitlines()]
out = "\n".join(lines)
# Multi-line: append trailing newline so the last command also executes.
# Single-line: leave it staged at the prompt for inspection.
if len(lines) > 1:
    out += "\n"
sys.stdout.write(out)
' \
  | xclip -selection clipboard -i

# Give the X server a moment to commit the new clipboard before pasting.
sleep 0.05

class=$(xdotool getactivewindow getwindowclassname 2>/dev/null)
case "${class,,}" in
  *kitty*|*alacritty*|*wezterm*|*foot*|*term*|*xterm*)
    xdotool key --clearmodifiers ctrl+shift+v
    ;;
  *)
    xdotool key --clearmodifiers ctrl+v
    ;;
esac
