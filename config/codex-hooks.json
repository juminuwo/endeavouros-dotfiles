{
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume|clear",
        "hooks": [
          {
            "type": "command",
            "command": "/home/howis/.local/bin/agents-dashboard-spawn"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash -c 'title=Codex message=\"Codex finished\" /home/howis/bin/claude-notify >/dev/null 2>&1'"
          }
        ]
      }
    ]
  }
}
